<%- include('partials/head') %>
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<h1>Billing</h1>
<p class="muted">Pay as you go — <b>₹50 per video</b> (up to 1&nbsp;GB each; a file over 1&nbsp;GB
counts as 2). Your first upload is free. Buy credits in multiples of 10 videos; an upload already
in progress always finishes even if credits run out, and the shortfall is settled on your next
top-up. GST invoices are issued separately.</p>

<div class="card" id="wallet-card">
  <div class="row" style="align-items:baseline; gap:2rem; justify-content:space-between">
    <div>
      <div class="muted">Wallet balance</div>
      <div id="balance" style="font-size:2rem; font-weight:700">—</div>
      <div id="balance-videos" class="muted"></div>
    </div>
    <div style="text-align:right">
      <div id="wallet-badges" style="margin-bottom:8px"></div>
      <button class="primary" id="open-topup">Buy video credits</button>
      <div id="topup-note" class="muted" style="margin-top:6px"></div>
    </div>
  </div>
</div>

<div class="card table-wrap">
  <h2>Transactions</h2>
  <table id="txn-table">
    <thead><tr><th>When</th><th>Type</th><th>Videos</th><th>Amount</th><th>Balance</th></tr></thead>
    <tbody></tbody>
  </table>
</div>

<!-- Pay-as-you-go modal -->
<div class="modal-backdrop" id="topup-modal">
  <div class="modal">
    <div class="modal-head">
      <h2>Pay as you go</h2>
      <button class="modal-close" id="close-topup" aria-label="Close">×</button>
    </div>
    <p class="muted" style="margin:0 0 8px">₹50 per video · buy in multiples of 10. Choose a pack:</p>
    <div id="pack-list"></div>

    <div style="margin-top:16px; border-top:1px solid var(--line); padding-top:14px">
      <label for="cust-videos">Or enter number of videos <span class="muted">(multiples of 10)</span></label>
      <div class="row" style="align-items:stretch; margin-top:4px">
        <input id="cust-videos" type="number" min="10" step="10" placeholder="e.g. 40" style="flex:1 1 auto">
        <button class="primary" id="cust-pay">Pay</button>
      </div>
      <div id="cust-calc" style="margin-top:8px"></div>
    </div>

    <p class="muted" style="margin-top:14px; font-size:12px">
      Each amount includes 18% GST and a 2.5% payment-gateway fee on (credit + GST).
      Your wallet is credited the video-credit amount only.</p>
  </div>
</div>

<script>
const fmtRs = (paise) => '₹' + (Number(paise) / 100).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
let CFG = null;
const packSize = () => Math.max(1, Math.round(CFG.minTopupPaise / CFG.pricePerUnitPaise)); // = 10

// Mirror of the server's topupBreakdown (rounded to whole paise).
function packMath(videos) {
  const base = videos * CFG.pricePerUnitPaise;
  const gst = Math.round(base * CFG.gstPercent / 100);
  const fee = Math.round((base + gst) * CFG.gatewayPercent / 100);
  return { base, gst, fee, total: base + gst + fee };
}

// In-situ validation: only whole multiples of the pack (10), at least one pack.
function validateVideos(raw) {
  const step = packSize();
  const n = Number(raw);
  if (raw === '' || raw == null || !Number.isFinite(n) || n <= 0) {
    return { ok: false, message: `Enter a number of videos (multiples of ${step}).` };
  }
  if (!Number.isInteger(n)) return { ok: false, message: `Whole numbers only, in multiples of ${step}.` };
  if (n < step) return { ok: false, message: `Minimum ${step} videos.` };
  if (n % step !== 0) {
    const lo = Math.max(step, Math.floor(n / step) * step), hi = Math.ceil(n / step) * step;
    return { ok: false, message: `Only multiples of ${step} allowed — try ${lo} or ${hi}.` };
  }
  return { ok: true, videos: n };
}

async function loadWallet() {
  CFG = await api('/billing');
  const perVideo = CFG.pricePerUnitPaise;
  const b = document.getElementById('balance');
  b.textContent = fmtRs(CFG.balance_paise);
  b.style.color = CFG.balance_paise < 0 ? 'var(--err)' : '';

  const vids = document.getElementById('balance-videos');
  if (CFG.unlimited) vids.textContent = 'Unmetered — uploads are not charged.';
  else if (CFG.balance_paise > 0) vids.textContent = '≈ ' + Math.floor(CFG.balance_paise / perVideo) + ' videos of credit';
  else if (CFG.balance_paise < 0) vids.textContent = 'Negative — buy credits to keep pushing.';
  else vids.textContent = CFG.free_upload_used ? 'No credits — buy a pack to push.' : '';

  const badges = [];
  if (CFG.unlimited) badges.push('<span class="badge ok">unlimited (unmetered)</span>');
  if (!CFG.free_upload_used) badges.push('<span class="badge">1 free upload available</span>');
  if (CFG.balance_paise < 0) badges.push('<span class="badge warn">negative balance</span>');
  document.getElementById('wallet-badges').innerHTML = badges.join(' ');

  const note = document.getElementById('topup-note');
  const btn = document.getElementById('open-topup');
  if (!CFG.paymentsEnabled) {
    note.innerHTML = '<span class="badge warn">Payments not enabled yet</span>';
    btn.disabled = true;
  } else { note.textContent = ''; btn.disabled = false; }
}

function buildPacks() {
  const step = packSize();
  const counts = [1, 2, 3].map((n) => n * step); // 10, 20, 30
  document.getElementById('pack-list').innerHTML = counts.map((videos) => {
    const m = packMath(videos);
    return `<button class="pack" onclick="buy(${videos})">
      <span class="videos">${videos} videos<small>up to 1 GB each</small></span>
      <span class="amt">
        <span class="total">${fmtRs(m.total)}</span>
        <span class="brk">${fmtRs(m.base)} credit + ${fmtRs(m.gst)} GST + ${fmtRs(m.fee)} fee</span>
      </span>
    </button>`;
  }).join('');
}

// Live calc under the custom field.
function refreshCustom() {
  const calc = document.getElementById('cust-calc');
  const r = validateVideos(document.getElementById('cust-videos').value);
  if (r.ok) {
    const m = packMath(r.videos);
    calc.className = 'muted';
    calc.innerHTML = `<b>${r.videos} videos = ${fmtRs(m.total)}</b><br>`
      + `${fmtRs(m.base)} credit + ${fmtRs(m.gst)} GST + ${fmtRs(m.fee)} fee`;
  } else {
    calc.innerHTML = `<span class="badge warn">${esc(r.message)}</span>`;
  }
}

const modal = document.getElementById('topup-modal');
function openModal() {
  buildPacks();
  document.getElementById('cust-videos').value = '';
  document.getElementById('cust-calc').innerHTML = '';
  modal.classList.add('open');
}
document.getElementById('open-topup').onclick = openModal;
document.getElementById('close-topup').onclick = () => modal.classList.remove('open');
modal.addEventListener('click', (e) => { if (e.target === modal) modal.classList.remove('open'); });
document.getElementById('cust-videos').addEventListener('input', refreshCustom);

// Pay button validates in situ; an invalid amount NEVER reaches Razorpay.
document.getElementById('cust-pay').onclick = () => {
  const r = validateVideos(document.getElementById('cust-videos').value);
  if (!r.ok) {
    refreshCustom();
    toast('In multiples of 10 videos allowed', 'warn');
    return;
  }
  buy(r.videos);
};

async function buy(videos) {
  const base = videos * CFG.pricePerUnitPaise;
  let order;
  try {
    order = await api('/billing/topup', { method: 'POST', body: { base_paise: base } });
  } catch (e) { toast(e.message, 'err'); return; }
  modal.classList.remove('open');
  // Hosted-redirect gateways (Easebuzz/PhonePe) send the browser to their page.
  if (order.mode === 'redirect' && order.redirectUrl) { window.location.href = order.redirectUrl; return; }
  const rzp = new Razorpay({
    key: order.keyId,
    order_id: order.orderId,
    amount: order.amount,
    currency: 'INR',
    name: 'VideoRouter',
    description: videos + ' video credits (' + fmtRs(order.breakdown.base) + ')',
    handler: async (resp) => {
      try {
        await api('/billing/confirm', { method: 'POST', body: {
          order_id: resp.razorpay_order_id,
          payment_id: resp.razorpay_payment_id,
          signature: resp.razorpay_signature,
        }});
        toast(videos + ' video credits added.');
        loadWallet(); loadTxns();
      } catch (e) { toast('Paid, but confirmation failed: ' + e.message + ' (it will reconcile via webhook).', 'err'); }
    },
    modal: { ondismiss: () => toast('Payment cancelled.', 'warn') },
  });
  rzp.on('payment.failed', (r) => toast('Payment failed: ' + (r.error?.description || 'unknown'), 'err'));
  rzp.open();
}

async function loadTxns() {
  const rows = await api('/billing/history');
  document.querySelector('#txn-table tbody').innerHTML = rows.map(t => {
    const amt = Number(t.amount_paise);
    const cls = amt >= 0 ? 'ok' : 'err';
    const vids = t.type === 'topup' && CFG ? Math.round(Number(t.amount_paise) / CFG.pricePerUnitPaise)
      : (t.units ? t.units : '');
    return `<tr>
      <td class="nowrap">${fmtDate(t.created_at)}</td>
      <td><span class="badge ${t.type === 'topup' ? 'ok' : (t.type === 'deduction' ? 'warn' : '')}">${esc(t.type)}</span></td>
      <td>${vids !== '' ? vids : '—'}</td>
      <td class="mono ${cls}">${amt >= 0 ? '+' : ''}${fmtRs(amt)}</td>
      <td class="mono">${fmtRs(t.balance_after_paise)}</td>
    </tr>`;
  }).join('') || '<tr><td colspan="5" class="muted">No transactions yet.</td></tr>';
}

(async () => {
  try { await loadWallet(); await loadTxns(); }
  catch (e) { toast(e.message, 'err'); }
})();
</script>
<%- include('partials/foot') %>
