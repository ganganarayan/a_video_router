<%- include('partials/head') %>
<h1>Source videos</h1>
<p class="muted">Live listing of your latest 20 recordings from Zoom and Fathom, matched against the pipeline log.
Each row has its own buttons: <b>Push to YouTube</b> uploads the recording, then <b>Push to LMS</b>
registers that video in your course (it stays active after the YouTube upload so you can push to the
LMS separately). <b>Download</b> saves the original to your computer (free, Zoom only).
<b>Delete from Zoom</b> unlocks only after that recording has a YouTube link.
Fathom recordings can be downloaded (reconstructed for you) but not deleted via API (storage is unlimited).</p>

<p class="row">
  <button id="refresh" class="primary">Refresh listing</button>
  <span class="muted" id="loading"></span>
</p>

<div class="card" id="upload-card">
  <h2>Upload a local file</h2>
  <p class="muted" style="margin-top:0">Send a video from your computer straight to YouTube (and, optionally,
    register it in your LMS course). Billed by size like any transfer.</p>
  <div class="row" style="flex-wrap:wrap; align-items:flex-end; gap:10px">
    <input type="file" id="up-file" accept="video/*">
    <select id="up-channel" title="YouTube channel"></select>
    <input id="up-title" placeholder="YouTube title (optional)" style="min-width:200px">
    <select id="up-lms" title="LMS course (optional)"></select>
    <button class="primary" id="up-go">Upload</button>
  </div>
  <div id="up-progress" class="muted" style="margin-top:8px"></div>
</div>

<div class="card" id="queue-card" style="display:none">
  <h2>Push queue</h2>
  <div class="table-wrap">
    <table id="queue-table">
      <thead><tr>
        <th>#</th><th>Video</th><th>Source</th><th>Status</th><th>Size</th><th>Speed</th>
        <th>Elapsed</th><th>ETA</th><th>Progress</th><th>Log / result</th><th></th>
      </tr></thead>
      <tbody></tbody>
    </table>
  </div>
</div>

<div class="card">
  <h2>On Zoom <span class="muted" id="zoom-note"></span></h2>
  <div class="table-wrap">
    <table id="zoom-table">
      <thead><tr>
        <th>Title</th><th>Recorded</th><th>Length</th><th>Size on Zoom</th><th>Speaker view</th>
        <th>Zoom status</th><th>Pipeline status</th><th>YouTube link</th><th>Push to… / actions</th>
      </tr></thead>
      <tbody></tbody>
    </table>
  </div>
</div>

<div class="card">
  <h2>On Fathom <span class="muted" id="fathom-note"></span></h2>
  <div class="table-wrap">
    <table id="fathom-table">
      <thead><tr>
        <th>Title</th><th>Recorded</th><th>Length</th><th>Pipeline status</th><th>YouTube link</th><th>Push to…</th>
      </tr></thead>
      <tbody></tbody>
    </table>
  </div>
</div>

<script>
function fmtBytes(n) {
  if (!n) return '—';
  const units = ['B', 'KB', 'MB', 'GB'];
  let i = 0;
  while (n >= 1024 && i < units.length - 1) { n /= 1024; i++; }
  return n.toFixed(i ? 1 : 0) + ' ' + units[i];
}
function fmtMin(m) { return m == null ? '—' : m + ' min'; }
function pipelineBadge(item) {
  if (item.status === 'not_processed') return '<span class="badge">not processed yet</span>';
  return statusBadge(item.status);
}
function ytCell(item) {
  return item.youtube_url
    ? linkWithCopy(item.youtube_url)
    : '<span class="muted">— not uploaded yet</span>';
}

let current = { zoom: [], fathom: [] };
let channels = [];
let lmsOptions = []; // {label, course_id, module_id}
let queueTimer = null;

function channelSelect(source, i, item) {
  if (item.youtube_url) return '<span class="muted">on YouTube ✓</span>';
  const opts = channels.map(c =>
    `<option value="${c.id}">${esc(c.label)}${c.connected ? '' : ' (not connected)'}</option>`).join('');
  return `<select data-ch="${source}:${i}" title="YouTube channel to upload to">
    <option value="">YouTube channel…</option>${opts}</select>`;
}

function lmsSelect(source, i, item) {
  if (!lmsOptions.length) return '';
  if (item.lms_lesson_url) return '<span class="muted">in LMS ✓</span>';
  const opts = lmsOptions.map((o, k) =>
    `<option value="${k}">${esc(o.label)}</option>`).join('');
  return `<select data-lms="${source}:${i}" title="LMS course to push into">
    <option value="">LMS course…</option>${opts}</select>`;
}

// Zoom rows: pick the exact recording file to act on. Before upload it chooses
// which file goes to YouTube (avoids the "no speaker-view" failure when a meeting
// only has other views); after upload it chooses which file Download grabs.
function fileSelect(source, i, item) {
  if (source !== 'zoom') return '';
  const files = item.files || [];
  if (!files.length) return '<span class="badge warn">no MP4 files</span>';
  const opts = files.map(f =>
    `<option value="${esc(f.id)}"${f.is_default ? ' selected' : ''}>${esc(f.recording_type)} (${fmtBytes(f.file_size)})</option>`
  ).join('');
  return `<select data-file="${source}:${i}" title="Which recording file to use">${opts}</select>`;
}

// Title + description to use for the YouTube upload (shown only before upload).
function titleDescFields(source, i, item) {
  if (item.youtube_url) return '';
  return `<input data-title="${source}:${i}" value="${esc(item.title)}"
      title="YouTube video title" placeholder="YouTube title" style="min-width:220px">
    <input data-desc="${source}:${i}" placeholder="description (optional)"
      title="YouTube description" style="min-width:220px">`;
}

// Download button — free direct download to the user's computer, on every row.
// Zoom streams the stored MP4 directly; Fathom is reconstructed from its HLS
// stream via ffmpeg and piped to you (may take a moment to start on big files).
function downloadBtn(source, i, item) {
  if (source === 'zoom') {
    const canDl = !item.source_deleted && (item.files || []).length;
    return `<button data-dl="zoom:${i}" ${canDl ? '' : 'disabled'}
      title="${canDl ? 'Download this recording to your computer (free)' : 'Not downloadable (deleted on Zoom or no MP4 file).'}">Download</button>`;
  }
  return `<button data-dl="fathom:${i}"
    title="Download this recording to your computer (free — reconstructed from Fathom, may take a moment to start)">Download</button>`;
}

// Delete-from-Zoom button — Zoom only, active only once the recording is on
// YouTube (the YouTube copy stays). Lives in the same action group so all row
// buttons sit together on the left instead of overflowing to a far column.
function deleteBtn(source, i, item) {
  if (source !== 'zoom') return '';
  return `<button class="danger" data-zoom-del="${i}" ${item.can_delete ? '' : 'disabled'}
    title="${item.can_delete
      ? 'Deletes this recording from Zoom (frees storage). The YouTube copy stays.'
      : 'Inactive until this recording has been uploaded to YouTube.'}">Delete from Zoom</button>`;
}

// A hidden player row inserted right under each recording. The <video> src is set
// lazily (only when Preview is clicked) so we don't stream N videos at once.
// Zoom plays via the inline (Range-capable) download route; Fathom via its route,
// which redirects to the signed CDN MP4.
function previewRow(source, i, cols) {
  return `<tr class="prev-row" id="prev-${source}-${i}" style="display:none">
    <td colspan="${cols}">
      <video controls preload="none" playsinline style="width:100%;max-width:640px;border-radius:8px;background:#000"></video>
      <div class="muted" style="margin-top:4px">Play to review the topic, then set the title above and Push to YouTube.</div>
    </td></tr>`;
}

// Each row now has THREE independent actions instead of one combined Push:
//   • Push to YouTube — uploads the recording (hidden once it is on YouTube).
//   • Push to LMS — registers the YouTube video in a course. Stays available
//     after the upload (it needs the YouTube link first, so it is disabled until
//     the video is on YouTube).
//   • Download — free copy to the user's computer (Zoom only).
function pushCell(source, i, item) {
  const parts = [];

  // --- YouTube leg ---
  if (item.youtube_url) {
    parts.push('<span class="muted">on YouTube ✓</span>');
  } else {
    parts.push(`${titleDescFields(source, i, item)}
      ${fileSelect(source, i, item)}
      ${channelSelect(source, i, item)}
      <button data-push-yt="${source}:${i}">Push to YouTube</button>`);
  }

  // --- LMS leg — always shown so the action set is consistent across rows.
  // Enabled only once the video is on YouTube AND an LMS course exists; otherwise
  // disabled with a tooltip that says exactly what's needed.
  if (item.lms_lesson_url) {
    parts.push('<span class="muted">in LMS ✓</span>');
  } else {
    const onYt = Boolean(item.youtube_url);
    const hasLms = lmsOptions.length > 0;
    const canLms = onYt && hasLms;
    const tip = !hasLms ? 'Add an LMS course in Routing first, then push it here.'
      : (!onYt ? 'Upload to YouTube first, then push to the LMS.'
        : 'Register this YouTube video in your LMS course.');
    parts.push(`${hasLms ? lmsSelect(source, i, item) : ''}
        <button data-push-lms="${source}:${i}" ${canLms ? '' : 'disabled'} title="${tip}">Push to LMS</button>`);
  }

  // --- Download + Delete legs (Zoom only) ---
  // For already-uploaded Zoom rows the file picker isn't shown above (the YouTube
  // leg is done), so render it here next to Download to choose which recording
  // file to grab. Pre-upload rows already show the picker in the YouTube leg.
  if (source === 'zoom' && item.youtube_url) parts.push(fileSelect(source, i, item));
  parts.push(`<button data-preview="${source}:${i}" title="Play this recording here to review it, then set the title and push">Preview</button>`);
  parts.push(downloadBtn(source, i, item));
  parts.push(deleteBtn(source, i, item));

  return `<div class="row" style="min-width:220px; flex-wrap:wrap; gap:6px">${parts.filter(Boolean).join('')}</div>`;
}

async function loadMeta() {
  const [conn, rules] = await Promise.all([api('/connections'), api('/rules')]);
  channels = conn.channels;
  lmsOptions = rules
    .filter(r => r.lms_course_id)
    .map(r => ({ label: `${r.pattern} → ${r.lms_course_id}`, course_id: r.lms_course_id, module_id: r.lms_module_id }));
}

async function load() {
  const btn = document.getElementById('refresh');
  btn.disabled = true;
  document.getElementById('loading').textContent = 'Fetching from Zoom & Fathom… (can take ~10s)';
  try {
    const s = await api('/sources');
    current = s;
    renderZoom(s);
    renderFathom(s);
  } catch (e) {
    toast(e.message, 'err');
  } finally {
    btn.disabled = false;
    document.getElementById('loading').textContent = '';
  }
}

function bindRowActions(tbody) {
  tbody.querySelectorAll('[data-push-yt]').forEach((btn) => {
    btn.onclick = () => pushYouTube(btn.dataset.pushYt, btn);
  });
  tbody.querySelectorAll('[data-push-lms]').forEach((btn) => {
    if (!btn.disabled) btn.onclick = () => pushLms(btn.dataset.pushLms, btn);
  });
  tbody.querySelectorAll('[data-dl]').forEach((btn) => {
    if (!btn.disabled) btn.onclick = () => downloadRow(btn.dataset.dl);
  });
  tbody.querySelectorAll('[data-zoom-del]').forEach((btn) => {
    btn.onclick = () => deleteFromZoom(Number(btn.dataset.zoomDel), btn);
  });
  tbody.querySelectorAll('[data-preview]').forEach((btn) => {
    btn.onclick = () => togglePreview(btn.dataset.preview);
  });
  // Zoom file picker: keep an open preview in sync with the selected view.
  tbody.querySelectorAll('[data-file]').forEach((sel) => {
    sel.addEventListener('change', () => onPreviewFileChange(sel.dataset.file));
  });
}

// The stream URL for a recording's preview. For Zoom it reflects the currently
// selected file (gallery / speaker view …) so the player follows the dropdown.
function previewUrl(source, i) {
  const item = (current[source] || [])[i];
  if (!item) return null;
  if (source === 'fathom') {
    return '/api/sources/fathom/download?source_id=' + encodeURIComponent(item.source_id);
  }
  const sel = document.querySelector(`[data-file="zoom:${i}"]`);
  let url = '/api/sources/zoom/download?source_id=' + encodeURIComponent(item.source_id) + '&inline=1';
  if (sel && sel.value) url += '&file_id=' + encodeURIComponent(sel.value);
  return url;
}

// (Re)point a row's <video> at the given URL only when it actually changed, so
// re-opening the same file doesn't re-fetch but switching files does.
function setPreviewSrc(v, url) {
  if (!url || v.dataset.loadedUrl === url) return;
  v.dataset.loadedUrl = url;
  v.src = url;
  v.load();
}

// Show/hide the inline player under a row. The src is set (or refreshed to match
// the selected file) each time it opens — earlier this only set src on the very
// first open, so it was stuck on whichever file was picked first.
function togglePreview(key) {
  const [source, iStr] = key.split(':');
  const i = Number(iStr);
  const row = document.getElementById(`prev-${source}-${i}`);
  if (!row) return;
  const v = row.querySelector('video');
  const opening = row.style.display === 'none';
  if (opening) {
    setPreviewSrc(v, previewUrl(source, i));
    row.style.display = '';
  } else {
    try { v.pause(); } catch { /* ignore */ }
    row.style.display = 'none';
  }
}

// When the Zoom file dropdown changes, follow it live if that row's preview is
// already open (otherwise it loads the right file the next time it opens).
function onPreviewFileChange(key) {
  const [source, iStr] = key.split(':');
  const i = Number(iStr);
  const row = document.getElementById(`prev-${source}-${i}`);
  if (!row || row.style.display === 'none') return;
  setPreviewSrc(row.querySelector('video'), previewUrl(source, i));
}

// Free direct download to the user's computer (attachment header makes the
// browser download without navigating away). Zoom streams the chosen stored MP4;
// Fathom is remuxed from HLS by the server and streamed back.
function downloadRow(key) {
  const [source, iStr] = key.split(':');
  const item = (current[source] || [])[Number(iStr)];
  if (!item) return;
  toast('Download started — keep this window open until it completes.');
  if (source === 'fathom') {
    window.location.href = '/api/sources/fathom/download?source_id=' + encodeURIComponent(item.source_id);
    return;
  }
  const sel = document.querySelector(`[data-file="zoom:${iStr}"]`);
  let url = '/api/sources/zoom/download?source_id=' + encodeURIComponent(item.source_id);
  if (sel && sel.value) url += '&file_id=' + encodeURIComponent(sel.value);
  window.location.href = url;
}

function renderZoom(s) {
  const note = document.getElementById('zoom-note');
  const tbody = document.querySelector('#zoom-table tbody');
  if (s.zoom === null) {
    note.textContent = s.errors.zoom ? '— error: ' + s.errors.zoom : '— Zoom is not connected';
    tbody.innerHTML = '';
    return;
  }
  note.textContent = `— showing ${s.zoom.length} of the latest ${s.limit} recording(s)`;
  tbody.innerHTML = s.zoom.map((z, i) => `
    <tr>
      <td>${esc(z.title)}</td>
      <td>${fmtDate(z.recorded_at)}</td>
      <td>${fmtMin(z.duration_minutes)}</td>
      <td>${fmtBytes(z.total_bytes)}</td>
      <td>${z.speaker_view
        ? `<span class="badge ok" title="${esc(z.speaker_view)}">✓</span>`
        : '<span class="badge warn">missing</span>'}</td>
      <td>${z.downloaded ? '<span class="badge ok">Downloaded</span>' : '<span class="badge">Not downloaded</span>'}</td>
      <td>${pipelineBadge(z)}${z.source_deleted ? ' <span class="badge ok">deleted on Zoom</span>' : ''}</td>
      <td>${ytCell(z)}</td>
      <td>${pushCell('zoom', i, z)}</td>
    </tr>
    ${previewRow('zoom', i, 9)}
  `).join('') || '<tr><td colspan="9" class="muted">No recordings on Zoom in this window.</td></tr>';
  bindRowActions(tbody);
}

function renderFathom(s) {
  const note = document.getElementById('fathom-note');
  const tbody = document.querySelector('#fathom-table tbody');
  if (s.fathom === null) {
    note.textContent = s.errors.fathom ? '— error: ' + s.errors.fathom : '— Fathom is not connected';
    tbody.innerHTML = '';
    return;
  }
  note.textContent = `— showing ${s.fathom.length} of the latest ${s.limit} recording(s)`;
  tbody.innerHTML = s.fathom.map((f, i) => `
    <tr>
      <td>${esc(f.title)}</td>
      <td>${fmtDate(f.recorded_at)}</td>
      <td>${fmtMin(f.duration_minutes)}</td>
      <td>${pipelineBadge(f)}</td>
      <td>${ytCell(f)}</td>
      <td>${pushCell('fathom', i, f)}</td>
    </tr>
    ${previewRow('fathom', i, 6)}
  `).join('') || '<tr><td colspan="6" class="muted">No recordings on Fathom in this window.</td></tr>';
  bindRowActions(tbody);
}

// Push to YouTube — uploads the recording. Channel + title (+ Zoom file) only;
// LMS is a separate button/job now.
async function pushYouTube(key, btn) {
  const [source, iStr] = key.split(':');
  const item = current[source][Number(iStr)];
  if (!item) return;
  const chSel = document.querySelector(`[data-ch="${key}"]`);
  const fileSel = document.querySelector(`[data-file="${key}"]`);
  const titleEl = document.querySelector(`[data-title="${key}"]`);
  const descEl = document.querySelector(`[data-desc="${key}"]`);
  const channelId = chSel?.value || null;
  const fileId = fileSel?.value || null;

  if (titleEl && !titleEl.value.trim()) return toast('Enter a YouTube title.', 'err');
  if (!channelId) return toast('Pick a YouTube channel — this video is not uploaded yet.', 'err');
  if (source === 'zoom' && (item.files || []).length && !fileId) {
    return toast('Pick which recording file to upload.', 'err');
  }
  await queuePush(btn, item.title, {
    source,
    source_id: item.source_id,
    file_id: fileId,
    title: item.title,
    video_title: titleEl?.value || null,
    description: descEl?.value || null,
    channel_id: channelId,
  });
}

// Push to LMS — registers the already-uploaded YouTube video in a course.
// Requires the YouTube link to exist first (the button is disabled until then).
async function pushLms(key, btn) {
  const [source, iStr] = key.split(':');
  const item = current[source][Number(iStr)];
  if (!item) return;
  if (!item.youtube_url) return toast('Upload to YouTube first, then push to the LMS.', 'err');
  const lmsSel = document.querySelector(`[data-lms="${key}"]`);
  const lmsOpt = lmsSel && lmsSel.value !== '' ? lmsOptions[Number(lmsSel.value)] : null;
  if (!lmsOpt) return toast('Pick an LMS course to push this video into.', 'err');
  await queuePush(btn, item.title, {
    source,
    source_id: item.source_id,
    title: item.title,
    lms_course_id: lmsOpt.course_id,
    lms_module_id: lmsOpt.module_id || null,
  });
}

async function queuePush(btn, title, body) {
  btn.disabled = true;
  try {
    const r = await api('/push', { method: 'POST', body });
    toast(r.duplicate ? 'Already queued.' : `Queued as job #${r.jobId}: ${title}`);
    pollQueue();
  } catch (e) {
    toast(e.message, 'err');
  } finally {
    btn.disabled = false;
  }
}

function queueBadge(j) {
  const cls = { queued: 'warn', processing: 'warn', done: 'ok', failed: 'err' }[j.status] || '';
  return `<span class="badge ${cls}">${j.status}</span>`;
}
function fmtBps(bps) { return bps ? fmtBytes(bps) + '/s' : '—'; }
function fmtDuration(ms) {
  if (ms == null) return '—';
  const s = Math.round(ms / 1000), m = Math.floor(s / 60);
  return m ? `${m}m ${s % 60}s` : `${s}s`;
}

function qSize(j) {
  // Final size first, then a known total; otherwise the bytes moved so far.
  // Fathom HLS has no total up front, so `done` is the live downloaded size —
  // show it instead of "—" so there's real progress feedback during download.
  const b = j.transfer?.fileSizeBytes || j.progress?.total || j.progress?.done || 0;
  return b ? fmtBytes(b) : '—';
}
function qSpeed(j) {
  if (j.status !== 'processing' || !j.progress) return '—';
  const phase = j.progress.phase;
  // Local uploads have no download leg — the "download" phase is just a local
  // file move, so its speed is meaningless. Only the ↑ upload leg is real.
  if (j.source === 'local' && phase !== 'upload') return '<span class="muted">local file</span>';
  const arrow = phase === 'upload' ? '↑' : (phase === 'download' ? '↓' : '');
  return `${arrow} ${fmtBps(j.progress.speedBps)}`;
}
function qElapsed(j) {
  if (j.status === 'done' && j.transfer) return fmtDuration(j.transfer.durationMs);
  return j.progress ? fmtDuration(j.progress.elapsedMs) : '—';
}
function qEta(j) {
  if (j.status !== 'processing' || !j.progress || j.progress.etaMs == null) return '—';
  return fmtDuration(j.progress.etaMs);
}
function qProgress(j) {
  if (j.status === 'done') return '<div class="pbar"><span style="width:100%"></span></div>';
  if (j.status === 'failed') return '—';
  const p = j.progress;
  if (j.status === 'processing' && (!p || p.pct == null)) return '<div class="pbar indet"><span></span></div>';
  if (!p || p.pct == null) return '<span class="muted">queued</span>';
  return `<div class="pbar"><span style="width:${p.pct}%"></span></div> <span class="muted">${p.pct}%</span>`;
}
function ytStatusNote(status) {
  if (!status) return '';
  if (status === 'uploaded') return ' · <span class="muted">YouTube: received, now processing</span>';
  if (status === 'processed') return ' · <span class="badge ok">YouTube: processed</span>';
  return ` · <span class="muted">YouTube: ${esc(status)}</span>`;
}
function qLog(j) {
  const links = [
    j.youtube_url ? `<a href="${esc(j.youtube_url)}" target="_blank">YouTube (unlisted)</a>` : '',
    j.lms_lesson_url ? `<a href="${esc(j.lms_lesson_url)}" target="_blank">LMS lesson</a>` : '',
  ].filter(Boolean).join(' · ');
  if (j.status === 'failed') return `<span class="badge err">failed</span> ${esc(j.message || '')}`;
  if (j.status === 'done') {
    const t = j.transfer;
    // Local uploads never downloaded anything — show "local file" instead of a
    // bogus average download speed.
    const dn = j.source === 'local' ? 'local file' : `avg ↓ ${fmtBps(t?.avgDownloadBps)}`;
    const stats = t
      ? `transfer: ${dn} · ↑ ${fmtBps(t.avgUploadBps)} · ${fmtBytes(t.fileSizeBytes)} · ${fmtDuration(t.durationMs)} · ${fmtDate(t.finishedAt)}`
      : esc(j.message || '');
    return `${stats}${ytStatusNote(j.youtube_status)}${links ? '<br>' + links : ''}`;
  }
  const phase = j.progress?.phase;
  const label = phase === 'upload'
    ? 'uploading to YouTube'
    : (j.source === 'local' ? 'preparing local file' : (phase === 'download' ? 'downloading' : (j.status || '')));
  return `<span class="muted">${esc(label)}…</span>`;
}
function qAction(j) {
  // Delete-from-Zoom activates only once the YouTube (unlisted) link exists.
  if (j.source !== 'zoom') return '';
  const on = Boolean(j.youtube_url);
  return `<button class="danger" data-qdel="${esc(j.source_id)}" ${on ? '' : 'disabled'}
    title="${on ? 'Delete this recording from Zoom (the YouTube copy stays).' : 'Activates after the YouTube link exists.'}">
    Delete from Zoom</button>`;
}

async function pollQueue() {
  clearTimeout(queueTimer);
  try {
    const jobs = await api('/push-queue');
    const card = document.getElementById('queue-card');
    if (!jobs.length) { card.style.display = 'none'; return; }
    card.style.display = '';
    const tbody = document.querySelector('#queue-table tbody');
    tbody.innerHTML = jobs.map(j => `
      <tr>
        <td>${j.id}</td>
        <td>${esc(j.title)}</td>
        <td>${esc(j.source)}</td>
        <td>${queueBadge(j)}</td>
        <td class="nowrap">${qSize(j)}</td>
        <td class="nowrap">${qSpeed(j)}</td>
        <td class="nowrap">${qElapsed(j)}</td>
        <td class="nowrap">${qEta(j)}</td>
        <td class="nowrap">${qProgress(j)}</td>
        <td>${qLog(j)}</td>
        <td>${qAction(j)}</td>
      </tr>
    `).join('');
    tbody.querySelectorAll('[data-qdel]').forEach((btn) => {
      if (!btn.disabled) btn.onclick = () => queueDelete(btn.dataset.qdel, btn);
    });
    const active = jobs.some(j => j.status === 'queued' || j.status === 'processing');
    if (active) {
      queueTimer = setTimeout(pollQueue, 1500); // fast refresh for live speed/progress
    } else if (window._queueWasActive) {
      load(); // statuses changed — refresh the listing
    }
    window._queueWasActive = active;
  } catch { /* transient */ }
}

async function queueDelete(sourceId, btn) {
  if (!confirm('Delete this recording from Zoom?\n\nThe YouTube copy stays.')) return;
  btn.disabled = true;
  try {
    const r = await api('/sources/zoom/delete', { method: 'POST', body: { source_id: sourceId } });
    toast(`Deleted from Zoom (${r.mode}).`);
    load();
    pollQueue();
  } catch (e) {
    toast(e.message, 'err');
    btn.disabled = false;
  }
}

async function deleteFromZoom(index, btn) {
  const item = current.zoom[index];
  if (!item) return;
  if (!confirm(`Delete "${item.title}" from Zoom?\n\nThe YouTube copy stays:\n${item.youtube_url}`)) return;
  btn.disabled = true;
  try {
    const r = await api('/sources/zoom/delete', { method: 'POST', body: { source_id: item.source_id } });
    toast(`Deleted from Zoom (${r.mode}): ${item.title}`);
    load();
  } catch (e) {
    toast(e.message, 'err');
    btn.disabled = !item.can_delete;
  }
}

// --- local file upload (feature: upload local files to YouTube / LMS) ---
function fillUploadSelects() {
  const ch = document.getElementById('up-channel');
  ch.innerHTML = '<option value="">— YouTube channel —</option>'
    + channels.map((c) => `<option value="${c.id}"${c.connected === false ? ' disabled' : ''}>${esc(c.label)}${c.connected === false ? ' (not connected)' : ''}</option>`).join('');
  const lms = document.getElementById('up-lms');
  lms.innerHTML = '<option value="">— LMS course (optional) —</option>'
    + lmsOptions.map((o, k) => `<option value="${k}">${esc(o.label)}</option>`).join('');
}

document.getElementById('up-go').onclick = async () => {
  const fileEl = document.getElementById('up-file');
  const file = fileEl.files[0];
  if (!file) return toast('Choose a file first.', 'err');
  const channelId = document.getElementById('up-channel').value;
  if (!channelId) return toast('Pick a YouTube channel.', 'err');
  const lmsIdx = document.getElementById('up-lms').value;
  const lmsPick = lmsIdx !== '' ? lmsOptions[Number(lmsIdx)] : null;
  const title = document.getElementById('up-title').value.trim();

  const prog = document.getElementById('up-progress');
  const btn = document.getElementById('up-go');

  // Pre-flight the billing gate BEFORE streaming the file. Otherwise the server's
  // 402 lands mid-upload, the connection resets, and the browser only reports a
  // generic "network error" — never the real "top up to continue" reason.
  btn.disabled = true;
  prog.textContent = 'Checking your balance…';
  try {
    const gate = await api('/uploads/preflight');
    if (!gate.allowed) {
      btn.disabled = false;
      prog.innerHTML = `<span class="badge err">${esc(gate.reason || 'Top up needed to upload.')}</span> `
        + `<a href="/billing">Buy credits →</a>`;
      return;
    }
  } catch (e) {
    btn.disabled = false;
    prog.innerHTML = `<span class="badge err">${esc(e.message || 'Could not check your balance.')}</span>`;
    return;
  }

  const params = new URLSearchParams({ channel_id: channelId, filename: file.name });
  if (title) params.set('title', title);
  if (lmsPick) { params.set('lms_course_id', lmsPick.course_id); if (lmsPick.module_id) params.set('lms_module_id', lmsPick.module_id); }

  const xhr = new XMLHttpRequest();
  xhr.open('POST', '/api/uploads?' + params.toString());
  xhr.setRequestHeader('Content-Type', file.type || 'application/octet-stream');
  xhr.upload.onprogress = (e) => {
    if (e.lengthComputable) prog.textContent = `Uploading ${(e.loaded / e.total * 100).toFixed(0)}% (${fmtBytes(e.loaded)} / ${fmtBytes(e.total)})…`;
  };
  xhr.onload = () => {
    btn.disabled = false;
    if (xhr.status >= 200 && xhr.status < 300) {
      prog.innerHTML = '<span class="badge ok">Uploaded — now transferring to YouTube (see the push queue).</span>';
      fileEl.value = ''; document.getElementById('up-title').value = '';
      pollQueue();
    } else if (xhr.status === 402) {
      let msg = 'Wallet empty — top up to upload.'; try { msg = JSON.parse(xhr.responseText).error || msg; } catch { /* non-JSON */ }
      prog.innerHTML = `<span class="badge err">${esc(msg)}</span> <a href="/billing">Buy credits →</a>`;
    } else {
      let msg = 'Upload failed'; try { msg = JSON.parse(xhr.responseText).error || msg; } catch { /* non-JSON */ }
      prog.innerHTML = `<span class="badge err">${esc(msg)}</span>`;
    }
  };
  xhr.onerror = () => { btn.disabled = false; prog.innerHTML = '<span class="badge err">Network error during upload.</span>'; };
  prog.textContent = 'Starting upload…';
  xhr.send(file);
};

document.getElementById('refresh').onclick = load;
loadMeta().then(() => { fillUploadSelects(); return load(); }).catch(e => toast(e.message, 'err'));
pollQueue();
</script>
