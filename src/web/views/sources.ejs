<%- include('partials/head') %>
<h1>Source videos</h1>
<p class="muted">Live listing from Zoom and Fathom (last 30 days), matched against the pipeline log.
Pick a destination per row and press <b>Push</b> — jobs queue up and process one by one.
<b>Delete from Zoom</b> unlocks only after that recording has a YouTube link.
Fathom cannot be deleted via API (storage is unlimited).</p>

<p class="row">
  <button id="refresh" class="primary">Refresh listing</button>
  <span class="muted" id="loading"></span>
</p>

<div class="card" id="queue-card" style="display:none">
  <h2>Push queue</h2>
  <div class="table-wrap">
    <table id="queue-table">
      <thead><tr>
        <th>#</th><th>Video</th><th>Source</th><th>Status</th><th>Size</th><th>Speed</th>
        <th>Elapsed</th><th>ETA</th><th>Progress</th><th>Log / result</th><th></th>
      </tr></thead>
      <tbody></tbody>
    </table>
  </div>
</div>

<div class="card">
  <h2>On Zoom <span class="muted" id="zoom-note"></span></h2>
  <div class="table-wrap">
    <table id="zoom-table">
      <thead><tr>
        <th>Title</th><th>Recorded</th><th>Length</th><th>Size on Zoom</th><th>Speaker view</th>
        <th>Zoom status</th><th>Pipeline status</th><th>YouTube link</th><th>Push to…</th><th></th>
      </tr></thead>
      <tbody></tbody>
    </table>
  </div>
</div>

<div class="card">
  <h2>On Fathom <span class="muted" id="fathom-note"></span></h2>
  <div class="table-wrap">
    <table id="fathom-table">
      <thead><tr>
        <th>Title</th><th>Recorded</th><th>Length</th><th>Pipeline status</th><th>YouTube link</th><th>Push to…</th>
      </tr></thead>
      <tbody></tbody>
    </table>
  </div>
</div>

<script>
function fmtBytes(n) {
  if (!n) return '—';
  const units = ['B', 'KB', 'MB', 'GB'];
  let i = 0;
  while (n >= 1024 && i < units.length - 1) { n /= 1024; i++; }
  return n.toFixed(i ? 1 : 0) + ' ' + units[i];
}
function fmtMin(m) { return m == null ? '—' : m + ' min'; }
function pipelineBadge(item) {
  if (item.status === 'not_processed') return '<span class="badge">not processed yet</span>';
  return statusBadge(item.status);
}
function ytCell(item) {
  return item.youtube_url
    ? `<a href="${esc(item.youtube_url)}" target="_blank">${esc(item.youtube_url)}</a>`
    : '<span class="muted">— not uploaded yet</span>';
}

let current = { zoom: [], fathom: [] };
let channels = [];
let lmsOptions = []; // {label, course_id, module_id}
let queueTimer = null;

function channelSelect(source, i, item) {
  if (item.youtube_url) return '<span class="muted">on YouTube ✓</span>';
  const opts = channels.map(c =>
    `<option value="${c.id}">${esc(c.label)}${c.connected ? '' : ' (not connected)'}</option>`).join('');
  return `<select data-ch="${source}:${i}" title="YouTube channel to upload to">
    <option value="">YouTube channel…</option>${opts}</select>`;
}

function lmsSelect(source, i, item) {
  if (!lmsOptions.length) return '';
  if (item.lms_lesson_url) return '<span class="muted">in LMS ✓</span>';
  const opts = lmsOptions.map((o, k) =>
    `<option value="${k}">${esc(o.label)}</option>`).join('');
  return `<select data-lms="${source}:${i}" title="LMS course to push into">
    <option value="">LMS course…</option>${opts}</select>`;
}

// Zoom rows: pick the exact recording file to upload (avoids the "no
// speaker-view" failure when a meeting only has other views).
function fileSelect(source, i, item) {
  if (source !== 'zoom' || item.youtube_url) return '';
  const files = item.files || [];
  if (!files.length) return '<span class="badge warn">no MP4 files</span>';
  const opts = files.map(f =>
    `<option value="${esc(f.id)}"${f.is_default ? ' selected' : ''}>${esc(f.recording_type)} (${fmtBytes(f.file_size)})</option>`
  ).join('');
  return `<select data-file="${source}:${i}" title="Which recording file to upload">${opts}</select>`;
}

// Title + description to use for the YouTube upload (shown only before upload).
function titleDescFields(source, i, item) {
  if (item.youtube_url) return '';
  return `<input data-title="${source}:${i}" value="${esc(item.title)}"
      title="YouTube video title" placeholder="YouTube title" style="min-width:220px">
    <input data-desc="${source}:${i}" placeholder="description (optional)"
      title="YouTube description" style="min-width:220px">`;
}

function pushCell(source, i, item) {
  return `<div class="row" style="min-width:220px">
    ${titleDescFields(source, i, item)}
    ${fileSelect(source, i, item)}
    ${channelSelect(source, i, item)}
    ${lmsSelect(source, i, item)}
    <button data-push="${source}:${i}">Push</button>
  </div>`;
}

async function loadMeta() {
  const [conn, rules] = await Promise.all([api('/connections'), api('/rules')]);
  channels = conn.channels;
  lmsOptions = rules
    .filter(r => r.lms_course_id)
    .map(r => ({ label: `${r.pattern} → ${r.lms_course_id}`, course_id: r.lms_course_id, module_id: r.lms_module_id }));
}

async function load() {
  const btn = document.getElementById('refresh');
  btn.disabled = true;
  document.getElementById('loading').textContent = 'Fetching from Zoom & Fathom… (can take ~10s)';
  try {
    const s = await api('/sources');
    current = s;
    renderZoom(s);
    renderFathom(s);
  } catch (e) {
    toast(e.message, 'err');
  } finally {
    btn.disabled = false;
    document.getElementById('loading').textContent = '';
  }
}

function bindRowActions(tbody) {
  tbody.querySelectorAll('[data-push]').forEach((btn) => {
    btn.onclick = () => pushRow(btn.dataset.push, btn);
  });
  tbody.querySelectorAll('[data-zoom-del]').forEach((btn) => {
    btn.onclick = () => deleteFromZoom(Number(btn.dataset.zoomDel), btn);
  });
}

function renderZoom(s) {
  const note = document.getElementById('zoom-note');
  const tbody = document.querySelector('#zoom-table tbody');
  if (s.zoom === null) {
    note.textContent = s.errors.zoom ? '— error: ' + s.errors.zoom : '— Zoom is not connected';
    tbody.innerHTML = '';
    return;
  }
  note.textContent = `— ${s.zoom.length} recording(s) in the last ${s.windowDays} days`;
  tbody.innerHTML = s.zoom.map((z, i) => `
    <tr>
      <td>${esc(z.title)}</td>
      <td>${fmtDate(z.recorded_at)}</td>
      <td>${fmtMin(z.duration_minutes)}</td>
      <td>${fmtBytes(z.total_bytes)}</td>
      <td>${z.has_target_view ? '✓' : '<span class="badge warn">missing</span>'}</td>
      <td>${z.downloaded ? '<span class="badge ok">Downloaded</span>' : '<span class="badge">Not downloaded</span>'}</td>
      <td>${pipelineBadge(z)}${z.source_deleted ? ' <span class="badge ok">deleted on Zoom</span>' : ''}</td>
      <td>${ytCell(z)}</td>
      <td>${pushCell('zoom', i, z)}</td>
      <td>
        <button class="danger" data-zoom-del="${i}" ${z.can_delete ? '' : 'disabled'}
          title="${z.can_delete
            ? 'Deletes this recording from Zoom (frees storage). The YouTube copy stays.'
            : 'Inactive until this recording has been uploaded to YouTube.'}">
          Delete from Zoom
        </button>
      </td>
    </tr>
  `).join('') || '<tr><td colspan="10" class="muted">No recordings on Zoom in this window.</td></tr>';
  bindRowActions(tbody);
}

function renderFathom(s) {
  const note = document.getElementById('fathom-note');
  const tbody = document.querySelector('#fathom-table tbody');
  if (s.fathom === null) {
    note.textContent = s.errors.fathom ? '— error: ' + s.errors.fathom : '— Fathom is not connected';
    tbody.innerHTML = '';
    return;
  }
  note.textContent = `— ${s.fathom.length} recording(s) in the last ${s.windowDays} days`;
  tbody.innerHTML = s.fathom.map((f, i) => `
    <tr>
      <td>${esc(f.title)}</td>
      <td>${fmtDate(f.recorded_at)}</td>
      <td>${fmtMin(f.duration_minutes)}</td>
      <td>${pipelineBadge(f)}</td>
      <td>${ytCell(f)}</td>
      <td>${pushCell('fathom', i, f)}</td>
    </tr>
  `).join('') || '<tr><td colspan="6" class="muted">No recordings on Fathom in this window.</td></tr>';
  bindRowActions(tbody);
}

async function pushRow(key, btn) {
  const [source, iStr] = key.split(':');
  const item = current[source][Number(iStr)];
  if (!item) return;
  const chSel = document.querySelector(`[data-ch="${key}"]`);
  const lmsSel = document.querySelector(`[data-lms="${key}"]`);
  const fileSel = document.querySelector(`[data-file="${key}"]`);
  const titleEl = document.querySelector(`[data-title="${key}"]`);
  const descEl = document.querySelector(`[data-desc="${key}"]`);
  const channelId = chSel?.value || null;
  const fileId = fileSel?.value || null;
  const lmsOpt = lmsSel?.value !== '' && lmsSel ? lmsOptions[Number(lmsSel.value)] : null;

  if (!item.youtube_url && titleEl && !titleEl.value.trim()) {
    return toast('Enter a YouTube title.', 'err');
  }

  if (!item.youtube_url && !channelId) {
    return toast('Pick a YouTube channel — this video is not uploaded yet.', 'err');
  }
  if (!item.youtube_url && source === 'zoom' && (item.files || []).length && !fileId) {
    return toast('Pick which recording file to upload.', 'err');
  }
  if (item.youtube_url && !lmsOpt) {
    return toast('Already on YouTube — pick an LMS course to push it into the LMS.', 'err');
  }
  btn.disabled = true;
  try {
    const r = await api('/push', { method: 'POST', body: {
      source,
      source_id: item.source_id,
      file_id: fileId,
      title: item.title,
      video_title: titleEl?.value || null,
      description: descEl?.value || null,
      channel_id: channelId,
      lms_course_id: lmsOpt?.course_id || null,
      lms_module_id: lmsOpt?.module_id || null,
    }});
    toast(r.duplicate ? 'Already queued.' : `Queued as job #${r.jobId}: ${item.title}`);
    pollQueue();
  } catch (e) {
    toast(e.message, 'err');
  } finally {
    btn.disabled = false;
  }
}

function queueBadge(j) {
  const cls = { queued: 'warn', processing: 'warn', done: 'ok', failed: 'err' }[j.status] || '';
  return `<span class="badge ${cls}">${j.status}</span>`;
}
function fmtBps(bps) { return bps ? fmtBytes(bps) + '/s' : '—'; }
function fmtDuration(ms) {
  if (ms == null) return '—';
  const s = Math.round(ms / 1000), m = Math.floor(s / 60);
  return m ? `${m}m ${s % 60}s` : `${s}s`;
}

function qSize(j) {
  const b = j.transfer?.fileSizeBytes || j.progress?.total || 0;
  return b ? fmtBytes(b) : '—';
}
function qSpeed(j) {
  if (j.status !== 'processing' || !j.progress) return '—';
  const arrow = j.progress.phase === 'upload' ? '↑' : (j.progress.phase === 'download' ? '↓' : '');
  return `${arrow} ${fmtBps(j.progress.speedBps)}`;
}
function qElapsed(j) {
  if (j.status === 'done' && j.transfer) return fmtDuration(j.transfer.durationMs);
  return j.progress ? fmtDuration(j.progress.elapsedMs) : '—';
}
function qEta(j) {
  if (j.status !== 'processing' || !j.progress || j.progress.etaMs == null) return '—';
  return fmtDuration(j.progress.etaMs);
}
function qProgress(j) {
  if (j.status === 'done') return '<div class="pbar"><span style="width:100%"></span></div>';
  if (j.status === 'failed') return '—';
  const p = j.progress;
  if (j.status === 'processing' && (!p || p.pct == null)) return '<div class="pbar indet"><span></span></div>';
  if (!p || p.pct == null) return '<span class="muted">queued</span>';
  return `<div class="pbar"><span style="width:${p.pct}%"></span></div> <span class="muted">${p.pct}%</span>`;
}
function ytStatusNote(status) {
  if (!status) return '';
  if (status === 'uploaded') return ' · <span class="muted">YouTube: received, now processing</span>';
  if (status === 'processed') return ' · <span class="badge ok">YouTube: processed</span>';
  return ` · <span class="muted">YouTube: ${esc(status)}</span>`;
}
function qLog(j) {
  const links = [
    j.youtube_url ? `<a href="${esc(j.youtube_url)}" target="_blank">YouTube (unlisted)</a>` : '',
    j.lms_lesson_url ? `<a href="${esc(j.lms_lesson_url)}" target="_blank">LMS lesson</a>` : '',
  ].filter(Boolean).join(' · ');
  if (j.status === 'failed') return `<span class="badge err">failed</span> ${esc(j.message || '')}`;
  if (j.status === 'done') {
    const t = j.transfer;
    const stats = t
      ? `transfer: avg ↓ ${fmtBps(t.avgDownloadBps)} · ↑ ${fmtBps(t.avgUploadBps)} · ${fmtBytes(t.fileSizeBytes)} · ${fmtDuration(t.durationMs)} · ${fmtDate(t.finishedAt)}`
      : esc(j.message || '');
    return `${stats}${ytStatusNote(j.youtube_status)}${links ? '<br>' + links : ''}`;
  }
  const phase = j.progress?.phase;
  const label = phase === 'upload' ? 'uploading to YouTube' : (phase === 'download' ? 'downloading' : (j.status || ''));
  return `<span class="muted">${esc(label)}…</span>`;
}
function qAction(j) {
  // Delete-from-Zoom activates only once the YouTube (unlisted) link exists.
  if (j.source !== 'zoom') return '';
  const on = Boolean(j.youtube_url);
  return `<button class="danger" data-qdel="${esc(j.source_id)}" ${on ? '' : 'disabled'}
    title="${on ? 'Delete this recording from Zoom (the YouTube copy stays).' : 'Activates after the YouTube link exists.'}">
    Delete from Zoom</button>`;
}

async function pollQueue() {
  clearTimeout(queueTimer);
  try {
    const jobs = await api('/push-queue');
    const card = document.getElementById('queue-card');
    if (!jobs.length) { card.style.display = 'none'; return; }
    card.style.display = '';
    const tbody = document.querySelector('#queue-table tbody');
    tbody.innerHTML = jobs.map(j => `
      <tr>
        <td>${j.id}</td>
        <td>${esc(j.title)}</td>
        <td>${esc(j.source)}</td>
        <td>${queueBadge(j)}</td>
        <td class="nowrap">${qSize(j)}</td>
        <td class="nowrap">${qSpeed(j)}</td>
        <td class="nowrap">${qElapsed(j)}</td>
        <td class="nowrap">${qEta(j)}</td>
        <td class="nowrap">${qProgress(j)}</td>
        <td>${qLog(j)}</td>
        <td>${qAction(j)}</td>
      </tr>
    `).join('');
    tbody.querySelectorAll('[data-qdel]').forEach((btn) => {
      if (!btn.disabled) btn.onclick = () => queueDelete(btn.dataset.qdel, btn);
    });
    const active = jobs.some(j => j.status === 'queued' || j.status === 'processing');
    if (active) {
      queueTimer = setTimeout(pollQueue, 1500); // fast refresh for live speed/progress
    } else if (window._queueWasActive) {
      load(); // statuses changed — refresh the listing
    }
    window._queueWasActive = active;
  } catch { /* transient */ }
}

async function queueDelete(sourceId, btn) {
  if (!confirm('Delete this recording from Zoom?\n\nThe YouTube copy stays.')) return;
  btn.disabled = true;
  try {
    const r = await api('/sources/zoom/delete', { method: 'POST', body: { source_id: sourceId } });
    toast(`Deleted from Zoom (${r.mode}).`);
    load();
    pollQueue();
  } catch (e) {
    toast(e.message, 'err');
    btn.disabled = false;
  }
}

async function deleteFromZoom(index, btn) {
  const item = current.zoom[index];
  if (!item) return;
  if (!confirm(`Delete "${item.title}" from Zoom?\n\nThe YouTube copy stays:\n${item.youtube_url}`)) return;
  btn.disabled = true;
  try {
    const r = await api('/sources/zoom/delete', { method: 'POST', body: { source_id: item.source_id } });
    toast(`Deleted from Zoom (${r.mode}): ${item.title}`);
    load();
  } catch (e) {
    toast(e.message, 'err');
    btn.disabled = !item.can_delete;
  }
}

document.getElementById('refresh').onclick = load;
loadMeta().then(load).catch(e => toast(e.message, 'err'));
pollQueue();
</script>
<%- include('partials/foot') %>
