<%- include('partials/head') %>
<h1>Connections</h1>
<p class="muted">All credentials are stored encrypted (AES-256-GCM) in Postgres — nothing lives in environment variables.</p>

<div class="grid">
  <div class="card">
    <h2>Zoom <span id="zoom-status"></span></h2>
    <p class="muted">Click <b>Connect Zoom</b> and approve access to your cloud recordings — that's it. No Zoom app or API keys to create.</p>
    <div id="zoom-not-ready" class="muted" style="display:none"></div>
    <div id="zoom-connected" style="display:none"><p>Connected as <b id="zoom-email"></b></p></div>
    <p class="row">
      <a id="zoom-connect-link" href="/oauth/zoom/start"><button class="primary" id="zoom-connect">Connect Zoom</button></a>
      <button id="zoom-test" style="display:none">Test connection</button>
      <button class="danger" id="zoom-disconnect" style="display:none">Disconnect</button>
    </p>
  </div>

  <div class="card">
    <h2>Fathom <span id="fathom-status"></span></h2>
    <label>API key</label><input id="fathom-api-key" type="password" autocomplete="new-password" placeholder="enter to save/replace">
    <p class="row">
      <button class="primary" id="fathom-save">Save</button>
      <button id="fathom-test">Test connection</button>
    </p>
    <p class="muted">Fathom is read-only: sources are never deleted there (storage is unlimited).</p>
  </div>

  <div class="card">
    <h2>LMS — myappz.ai <span id="lms-status"></span></h2>
    <label>Base URL</label><input id="lms-base-url" placeholder="https://login.applygitawisdom.com">
    <label>API key</label><input id="lms-api-key" type="password" autocomplete="new-password" placeholder="enter to save/replace">
    <p class="row">
      <button class="primary" id="lms-save">Save</button>
      <button id="lms-test">Test connection</button>
    </p>
    <p class="muted">Optional — until connected, uploads stay <span class="mono">lms_status=pending</span> and are pushed automatically once you connect. Per-tag course/module IDs are set on each routing rule.</p>
  </div>
</div>

<div class="card">
  <h2>YouTube channels</h2>
  <p class="muted">Add a channel, click <b>Connect</b>, and sign in with the Google account that owns the YouTube
  channel — that's it. No Google Cloud project or API keys needed.</p>
  <div id="yt-not-ready" class="muted" style="display:none"></div>
  <div class="table-wrap">
    <table id="channels-table">
      <thead><tr><th>Label</th><th>Channel</th><th>Status</th><th></th></tr></thead>
      <tbody></tbody>
    </table>
  </div>
  <h2 style="margin-top:16px">Add channel</h2>
  <div class="row">
    <div class="field"><label>Label</label><input id="ch-label" placeholder="Gita main"></div>
    <button class="primary" id="ch-add">Add & connect</button>
  </div>
</div>

<script>
function connBadge(el, status) {
  document.getElementById(el).innerHTML = status ? statusBadge(status) : '<span class="badge">not set up</span>';
}

async function load() {
  const c = await api('/connections');
  const notReady = document.getElementById('yt-not-ready');
  notReady.style.display = c.youtubeReady ? 'none' : 'block';
  if (!c.youtubeReady) notReady.innerHTML = '<span class="badge err">YouTube uploads are not set up on this platform yet — contact the administrator.</span>';
  document.getElementById('ch-add').disabled = !c.youtubeReady;

  const zr = document.getElementById('zoom-not-ready');
  zr.style.display = c.zoomReady ? 'none' : 'block';
  if (!c.zoomReady) zr.innerHTML = '<span class="badge err">Zoom is not set up on this platform yet — contact the administrator.</span>';
  document.getElementById('zoom-connect').disabled = !c.zoomReady;
  const zConnected = !!(c.zoom && (c.zoom.is_oauth || c.zoom.status === 'connected'));
  document.getElementById('zoom-connected').style.display = zConnected ? 'block' : 'none';
  if (zConnected) document.getElementById('zoom-email').textContent = c.zoom.oauth_email || c.zoom.account_id || 'your Zoom account';
  document.getElementById('zoom-connect').textContent = zConnected ? 'Reconnect' : 'Connect Zoom';
  document.getElementById('zoom-test').style.display = zConnected ? '' : 'none';
  document.getElementById('zoom-disconnect').style.display = zConnected ? '' : 'none';
  connBadge('zoom-status', c.zoom?.status);
  connBadge('fathom-status', c.fathom?.status);
  if (c.lms) document.getElementById('lms-base-url').value = c.lms.base_url;
  connBadge('lms-status', c.lms?.status);

  document.querySelector('#channels-table tbody').innerHTML = c.channels.map(ch => `
    <tr>
      <td>${esc(ch.label)}</td>
      <td>${ch.channel_handle ? esc(ch.channel_handle) : (ch.channel_id ? esc(ch.channel_id) : '—')}</td>
      <td>${ch.status === 'reauth_required'
        ? '<span class="badge err">needs reconnect</span>'
        : (ch.connected ? statusBadge('connected') : statusBadge('disconnected'))}</td>
      <td class="row">
        <a href="/oauth/youtube/start/${ch.id}"><button class="${ch.status === 'reauth_required' ? 'primary' : ''}">${ch.connected ? 'Reconnect' : 'Connect'}</button></a>
        <button class="danger" onclick="delChannel(${ch.id})">Delete</button>
      </td>
    </tr>
  `).join('') || '<tr><td colspan="4" class="muted">No channels yet — add one below.</td></tr>';
}

async function saveTest(kind, saveBody, statusEl) {
  try {
    if (saveBody) await api('/connections/' + kind, { method: 'POST', body: saveBody });
    const r = await api(`/connections/${kind}/test`, { method: 'POST' });
    toast(r.detail || 'Connection OK');
  } catch (e) { toast(e.message, 'err'); }
  load();
}

document.getElementById('zoom-test').onclick = () => saveTest('zoom', null);
document.getElementById('zoom-disconnect').onclick = async () => {
  if (!confirm('Disconnect Zoom? Recordings already routed are unaffected.')) return;
  try { await api('/connections/zoom/disconnect', { method: 'POST' }); toast('Zoom disconnected'); }
  catch (e) { toast(e.message, 'err'); }
  load();
};

document.getElementById('fathom-save').onclick = async () => {
  try {
    await api('/connections/fathom', { method: 'POST', body: { api_key: document.getElementById('fathom-api-key').value } });
    toast('Fathom API key saved'); load();
  } catch (e) { toast(e.message, 'err'); }
};
document.getElementById('fathom-test').onclick = () => saveTest('fathom', null);

document.getElementById('lms-save').onclick = async () => {
  try {
    await api('/connections/lms', { method: 'POST', body: {
      base_url: document.getElementById('lms-base-url').value,
      api_key: document.getElementById('lms-api-key').value,
    }});
    toast('LMS settings saved'); load();
  } catch (e) { toast(e.message, 'err'); }
};
document.getElementById('lms-test').onclick = () => saveTest('lms', null);

document.getElementById('ch-add').onclick = async () => {
  try {
    const r = await api('/channels', { method: 'POST', body: {
      label: document.getElementById('ch-label').value,
    }});
    location.href = r.connectUrl; // straight into the Google consent flow
  } catch (e) { toast(e.message, 'err'); }
};

async function delChannel(id) {
  if (!confirm('Delete this channel entry? (The YouTube channel itself is untouched.)')) return;
  try { await api('/channels/' + id, { method: 'DELETE' }); toast('Channel removed'); }
  catch (e) { toast(e.message, 'err'); }
  load();
}

const params = new URLSearchParams(location.search);
if (params.get('yt') === 'connected') toast('YouTube channel connected: ' + (params.get('title') || ''));
if (params.get('yt') === 'error') toast('YouTube connect failed: ' + (params.get('message') || ''), 'err');
if (params.get('zoom') === 'connected') toast('Zoom connected: ' + (params.get('email') || ''));
if (params.get('zoom') === 'error') toast('Zoom connect failed: ' + (params.get('message') || ''), 'err');

load();
</script>
<%- include('partials/foot') %>
