<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>AVideoRouter — Set a new password</title>
  <link rel="stylesheet" href="/public/style.css">
  <script src="/public/theme.js"></script>
  <script src="/public/eye.js"></script>
</head>
<body>
<main>
  <div class="card login-box">
    <h1><span style="color:var(--accent)">A</span>Video<span style="color:var(--accent)">Router</span></h1>
    <h2 style="font-size:1.1rem;margin:.2rem 0 .6rem">Set a new password</h2>
    <% if (!valid) { %>
      <p class="badge err">This reset link is invalid or has expired.</p>
      <p class="muted" style="margin-top:14px"><a href="/forgot">Request a new link</a></p>
    <% } else { %>
      <% if (error) { %><p class="badge err"><%= error %></p><% } %>
      <form method="post" action="/reset-password">
        <input type="hidden" name="token" value="<%= token %>">
        <label>New password</label>
        <input type="password" name="password" required minlength="8" autofocus autocomplete="new-password">
        <p><button class="primary" type="submit">Set new password</button></p>
      </form>
    <% } %>
  </div>
</main>
</body>
</html>
