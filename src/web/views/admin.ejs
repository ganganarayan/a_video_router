async function resetOwnerPw(id, email) {
  const pw = prompt('Set a new password for ' + email + ' (min 8 characters):');
  if (pw === null) return;
  if (pw.length < 8) { toast('Password must be at least 8 characters.', 'err'); return; }
  try {
    await api('/admin/tenants/' + id + '/owner-password', { method: 'POST', body: { password: pw } });
    toast('Password set for ' + email + ' — share it so they can log in.');
  } catch (e) { toast(e.message, 'err'); }
}

async function loadEmail() {
  try {
    const e = await api('/admin/email');
    document.getElementById('email-fromname').value = e.fromName || '';
    document.getElementById('email-from').value = e.from || '';
    document.getElementById('email-host').value = e.host || '';
    document.getElementById('email-port').value = e.port || '';
    document.getElementById('email-security').value = e.security || '';
    document.getElementById('email-username').value = e.username || '';
    document.getElementById('email-zepto-region').value = e.zeptoRegion || 'in';
    const configured = e.from && (e.hasZeptoToken || e.hasPassword);
    const method = e.hasZeptoToken ? 'ZeptoMail (HTTP)' : (e.hasPassword ? 'SMTP' : '');
    document.getElementById('email-status').innerHTML = configured
      ? '<span class="badge ok">email configured — ' + method + '</span>'
      : '<span class="badge warn">not configured — password resets can’t send</span>';
  } catch (er) { document.getElementById('email-status').textContent = er.message; }
}
document.getElementById('email-save').onclick = async () => {
  try {
    await api('/admin/email', { method: 'POST', body: {
      from_name: document.getElementById('email-fromname').value.trim(),
      from: document.getElementById('email-from').value.trim(),
      zepto_token: document.getElementById('email-zepto-token').value.trim(),
      zepto_region: document.getElementById('email-zepto-region').value,
      host: document.getElementById('email-host').value.trim(),
      port: document.getElementById('email-port').value.trim(),
      security: document.getElementById('email-security').value,
      username: document.getElementById('email-username').value.trim(),
      app_password: document.getElementById('email-pass').value.trim(),
    } });
    document.getElementById('email-pass').value = '';
    document.getElementById('email-zepto-token').value = '';
    toast('Email settings saved.'); loadEmail();
  } catch (e) { toast(e.message, 'err'); }
};
document.getElementById('email-test').onclick = async () => {
  const out = document.getElementById('email-test-out');
  out.style.display = ''; out.textContent = 'Sending test email…';
  try {
    const r = await api('/admin/email/test', { method: 'POST', body: {} });
    const via = r.used?.provider === 'zeptomail' ? ' via ZeptoMail' : (r.used?.provider === 'smtp' ? ' via SMTP' : '');
    out.textContent = '✓ Sent a test email to ' + r.to + via + '. Check that inbox.';
  } catch (e) { out.textContent = '✗ ' + e.message; }
};

document.getElementById('ao-plan-save').onclick = async () => {
  try {
    const rs = Number(document.getElementById('ao-price-rs').value);
    await api('/admin/billing/always-on', { method: 'POST', body: {
      plan_id: document.getElementById('ao-plan').value.trim(),
