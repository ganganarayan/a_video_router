<%- include('partials/head') %>
<h1>Super admin — tenants</h1>
<p class="muted">All tenant workspaces. Impersonate one to work inside it exactly as its admin sees it.</p>

<div class="card" id="rzp-card">
  <h2>Platform payments</h2>
  <div class="field" style="max-width:300px">
    <label>Active gateway</label>
    <select id="pay-provider"></select>
  </div>
  <div id="provider-note" class="muted" style="margin:6px 0 14px"></div>

  <h3 style="margin:0 0 6px">Razorpay</h3>
  <p class="muted">Your platform Razorpay account collects tenant top-ups. Keys are stored
  encrypted — no redeploy needed. Set the webhook to
  <span class="mono" id="webhook-url">…/api/billing/webhook</span> (event <span class="mono">payment.captured</span>).</p>
  <div id="rzp-status" class="muted"></div>
  <div class="row" style="align-items:flex-end; flex-wrap:wrap">
    <div class="field"><label>Key ID</label><input id="rzp-keyid" placeholder="rzp_test_..." style="min-width:220px"></div>
    <div class="field"><label>Key secret</label><input id="rzp-secret" type="password" autocomplete="new-password" placeholder="leave blank to keep"></div>
    <div class="field"><label>Webhook secret</label><input id="rzp-webhook" type="password" autocomplete="new-password" placeholder="leave blank to keep"></div>
    <button class="primary" id="rzp-save">Save keys</button>
  </div>
  <div class="row" style="align-items:flex-end; flex-wrap:wrap; margin-top:14px; border-top:1px solid var(--line); padding-top:14px">
    <div class="field"><label>Always-On plan ID <span class="muted">(Razorpay Subscriptions plan)</span></label>
      <input id="ao-plan" placeholder="plan_…" style="min-width:240px"></div>
    <div class="field"><label>Price ₹/mo (display only)</label><input id="ao-price-rs" type="number" placeholder="999" style="width:130px"></div>
    <button class="primary" id="ao-plan-save">Save plan</button>
  </div>
  <div id="ao-plan-note" class="muted" style="margin-top:6px">Optional — the ₹999/month plan is auto-created on the first subscription (Razorpay Subscriptions must be enabled on the account). Paste a plan_id here only to override with your own plan.</div>
</div>

<div class="card" id="landing-card">
  <h2>Landing page video</h2>
  <p class="muted">Video shown below the hero on your public landing page
  (<span class="mono">/</span>). Paste <b>either</b> a VidaPulse (or any) embed <b>URL</b>
  (<span class="mono">https://…/embed/…</span>) <b>or</b> a full embed <b>code</b> (the whole
  <span class="mono">&lt;div&gt;…&lt;iframe&gt;…</span> block). The page reads it live, so you can
  swap it anytime without touching code. Leave blank to hide the video.</p>
  <div class="row" style="align-items:flex-end">
    <div class="field" style="flex:1 1 420px"><label>Video embed URL or code</label>
      <textarea id="landing-video" rows="3" placeholder="https://…/embed/…  — or paste the full embed code" style="width:100%"></textarea></div>
    <button class="primary" id="landing-save">Save</button>
    <a id="landing-preview" href="/" target="_blank">Open landing ↗</a>
  </div>
</div>

<div class="card" id="meta-card">
  <h2>Meta Pixel &amp; Conversions API</h2>
  <p class="muted">Ad tracking for the public marketing pages (landing / FAQ / KB). The Pixel fires
  PageView in the browser; the Conversions API sends deduplicated server-side events (Lead,
  CompleteRegistration, Purchase). Set the webhook-safe CAPI token from Events Manager → Settings.</p>
  <div id="meta-status" class="muted" style="margin-bottom:8px"></div>
  <div class="row" style="align-items:flex-end; flex-wrap:wrap">
    <div class="field"><label>Pixel ID (= dataset ID)</label><input id="meta-pixel" placeholder="1234567890" style="min-width:200px"></div>
    <div class="field"><label>CAPI access token</label><input id="meta-token" type="password" autocomplete="new-password" placeholder="leave blank to keep"></div>
    <div class="field"><label>Test event code <span class="muted">(optional)</span></label><input id="meta-testcode" placeholder="TEST12345" style="width:150px"></div>
    <button class="primary" id="meta-save">Save</button>
    <button id="meta-test">Test CAPI</button>
  </div>
  <pre id="meta-test-out" class="muted" style="white-space:pre-wrap; margin-top:8px; display:none"></pre>
</div>

<div class="card" id="google-card">
  <h2>Google Sign-In</h2>
  <p class="muted">Lets visitors sign up / log in with Google on the public signup page. Create an OAuth client
  in Google Cloud (APIs &amp; Services → Credentials → OAuth client ID → Web application) and add this redirect
  URI: <span class="mono" id="google-redirect">…/oauth/google/callback</span></p>
  <div id="google-status" class="muted" style="margin-bottom:8px"></div>
  <div class="row" style="align-items:flex-end; flex-wrap:wrap">
    <div class="field"><label>Client ID</label><input id="google-cid" placeholder="....apps.googleusercontent.com" style="min-width:280px"></div>
    <div class="field"><label>Client secret</label><input id="google-secret" type="password" autocomplete="new-password" placeholder="leave blank to keep"></div>
    <button class="primary" id="google-save">Save</button>
  </div>
</div>

<div class="card" id="youtube-card">
  <h2>YouTube uploads (platform OAuth)</h2>
  <p class="muted">One Google OAuth app used by <b>every</b> tenant, so clients connect a channel with a single click —
  no Google Cloud project of their own. In Google Cloud create an OAuth client (APIs &amp; Services → Credentials →
  OAuth client ID → Web application), enable the <span class="mono">YouTube Data API v3</span>, add the
  <span class="mono">youtube.upload</span> + <span class="mono">youtube</span> scopes on the consent screen, and add
  this redirect URI: <span class="mono" id="youtube-redirect">…/oauth/youtube/callback</span></p>
  <p class="muted">Note: the upload scope is <b>restricted</b> — publish &amp; verify this app (a security assessment
  may be required) or connected channels are capped at test users and tokens expire weekly. All tenants share this
  app's daily upload quota.</p>
  <div id="youtube-status" class="muted" style="margin-bottom:8px"></div>
  <div class="row" style="align-items:flex-end; flex-wrap:wrap">
    <div class="field"><label>Client ID</label><input id="youtube-cid" placeholder="....apps.googleusercontent.com" style="min-width:280px"></div>
    <div class="field"><label>Client secret</label><input id="youtube-secret" type="password" autocomplete="new-password" placeholder="leave blank to keep"></div>
    <button class="primary" id="youtube-save">Save</button>
  </div>
</div>

<div class="card" id="zoom-card">
  <h2>Zoom (platform OAuth)</h2>
  <p class="muted">One Zoom OAuth app used by <b>every</b> tenant, so clients connect Zoom with a single consent —
  no Server-to-Server app of their own. In the Zoom Marketplace build a <b>User-managed OAuth</b> app, add the
  cloud-recording read/delete + user read scopes, and add this redirect URL: <span class="mono" id="zoom-redirect">…/oauth/zoom/callback</span></p>
  <p class="muted">Note: to let clients outside your own Zoom account connect, the app must be <b>published</b> on the
  Zoom Marketplace (Zoom review). Until then only users in your own Zoom account can connect.</p>
  <div id="zoom-status" class="muted" style="margin-bottom:8px"></div>
  <div class="row" style="align-items:flex-end; flex-wrap:wrap">
    <div class="field"><label>Client ID</label><input id="zoom-cid" placeholder="Zoom OAuth Client ID" style="min-width:280px"></div>
    <div class="field"><label>Client secret</label><input id="zoom-secret" type="password" autocomplete="new-password" placeholder="leave blank to keep"></div>
    <button class="primary" id="zoom-save">Save</button>
  </div>
</div>

<div class="card" id="email-card">
  <h2>Platform email</h2>
  <p class="muted">Account used to send self-serve <b>password reset</b> emails. Without this, "Forgot
  password" can't email a link.</p>
  <p class="muted" style="border-left:3px solid #4a7; padding-left:10px">⚡ <b>Recommended: ZeptoMail (Zoho's HTTP API).</b>
  This host blocks outbound SMTP, so plain SMTP/Zoho times out. ZeptoMail sends over HTTPS and works here.
  In <b>ZeptoMail</b> (zoho.com/zeptomail): add &amp; verify the domain <span class="mono">divineleads.guru</span>,
  create a <b>Mail Agent</b>, copy its <b>Send Mail Token</b>, and paste it below. Set the From address to a
  verified address (e.g. connect@divineleads.guru). Leave the token blank to fall back to SMTP/Gmail.</p>
  <div id="email-status" class="muted" style="margin-bottom:8px"></div>
  <div class="row" style="align-items:flex-end; flex-wrap:wrap">
    <div class="field"><label>From name <span class="muted">(optional)</span></label><input id="email-fromname" placeholder="AVideoRouter" style="min-width:150px"></div>
    <div class="field"><label>From address</label><input id="email-from" placeholder="connect@divineleads.guru" style="min-width:220px"></div>
    <div class="field"><label>ZeptoMail token <span class="muted">(Send Mail Token)</span></label><input id="email-zepto-token" type="password" autocomplete="new-password" placeholder="leave blank to keep" style="min-width:220px"></div>
    <div class="field"><label>ZeptoMail region</label>
      <select id="email-zepto-region">
        <option value="in">India (.in)</option>
        <option value="com">Global (.com)</option>
      </select></div>
  </div>
  <p class="muted" style="margin:4px 0">SMTP fallback (only used when no ZeptoMail token is set):</p>
  <div class="row" style="align-items:flex-end; flex-wrap:wrap">
    <div class="field"><label>SMTP host <span class="muted">(blank = Gmail)</span></label><input id="email-host" placeholder="smtp.zoho.in" style="min-width:150px"></div>
    <div class="field"><label>Port</label><input id="email-port" type="number" placeholder="465" style="width:80px"></div>
    <div class="field"><label>Security</label>
      <select id="email-security">
        <option value="">Auto (by port)</option>
        <option value="ssl">SSL/TLS (465)</option>
        <option value="starttls">STARTTLS (587)</option>
        <option value="none">None</option>
      </select></div>
    <div class="field"><label>Username <span class="muted">(blank = From)</span></label><input id="email-username" autocomplete="off" placeholder="same as From address" style="min-width:180px"></div>
    <div class="field"><label>Password / app password</label><input id="email-pass" type="password" autocomplete="new-password" placeholder="leave blank to keep"></div>
    <button class="primary" id="email-save">Save</button>
    <button id="email-test">Send test</button>
  </div>
  <pre id="email-test-out" class="muted" style="white-space:pre-wrap; margin-top:8px; display:none"></pre>
</div>

<div class="card">
  <h2>Usage audit <span class="muted">— recompute “Used” from actual bytes</span></h2>
  <p class="muted" style="margin-top:0">The <b>Used</b> column sums historical wallet deductions, and pre-fractional-metering rows
    were rounded up to whole GB — so Used reads high. This recomputes each deduction from the recording’s
    <b>actual bytes</b> and shows the gap, plus the proportional paise a metered tenant was over-charged.
    <b>Read-only</b> — running this changes nothing.</p>
  <p class="row"><button id="run-audit">Run usage audit</button> <span id="audit-note" class="muted"></span></p>
  <div id="audit-wrap" class="table-wrap" style="display:none">
    <table id="audit-table">
      <thead><tr>
        <th>#</th><th>Workspace</th><th>Metered</th><th>Rows (fixable/total)</th>
        <th>Used now</th><th>Actual</th><th>Over</th><th>Charged</th><th>Refund</th><th>Balance → after</th>
      </tr></thead>
      <tbody></tbody>
    </table>
  </div>
</div>

<div class="card table-wrap">
  <table id="tenants-table">
    <thead><tr>
      <th>#</th><th>Slug</th><th>Name</th><th>Owner email</th><th>Acquired</th><th>Status</th><th>Users</th>
      <th>Channels</th><th>Uploaded</th><th>Data</th><th>Balance</th><th>Used</th>
      <th>Plan</th><th></th>
    </tr></thead>
    <tbody></tbody>
  </table>
</div>

<script>
function rupees(paise) {
  if (paise == null) return '—';
  return '₹' + (Number(paise) / 100).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}

// GB balances are byte-accurate (fractional). Show up to 2 decimals, trimmed.
function fmtGb(n) {
  if (n == null) return '—';
  return (Math.round((Number(n) || 0) * 100) / 100).toLocaleString(undefined);
}

// Actual data uploaded, in binary units (matches unit_bytes = 1 GiB).
function fmtBytes(bytes) {
  const n = Number(bytes) || 0;
  if (n < 1024) return n + ' B';
  const units = ['KB', 'MB', 'GB', 'TB', 'PB'];
  let v = n / 1024, i = 0;
  while (v >= 1024 && i < units.length - 1) { v /= 1024; i++; }
  return v.toLocaleString(undefined, { maximumFractionDigits: v < 10 ? 2 : 1 }) + ' ' + units[i];
}

const PROVIDER_LABELS = { razorpay: 'Razorpay', easebuzz: 'Easebuzz', phonepe: 'PhonePe' };

async function loadConfig() {
  document.getElementById('webhook-url').textContent = location.origin + '/api/billing/webhook';
  try {
    const c = await api('/admin/billing/config');

    const sel = document.getElementById('pay-provider');
    sel.innerHTML = (c.providers || ['razorpay']).map((p) => {
      const live = (c.liveProviders || []).includes(p);
      return `<option value="${p}"${p === c.provider ? ' selected' : ''}>`
        + `${PROVIDER_LABELS[p] || p}${live ? '' : ' (activation pending)'}</option>`;
    }).join('');
    const note = document.getElementById('provider-note');
    if (!(c.liveProviders || []).includes(c.provider)) {
      note.innerHTML = `<span class="badge warn">${PROVIDER_LABELS[c.provider] || c.provider} adapter not built yet</span> `
        + 'tenant top-ups will fail until you switch back to Razorpay.';
    } else {
      note.innerHTML = `Tenants pay through <b>${PROVIDER_LABELS[c.provider] || c.provider}</b>. `
        + 'Easebuzz and PhonePe are wired into the schema and will be enabled once those accounts activate.';
    }

    document.getElementById('rzp-keyid').value = c.keyId || '';
    document.getElementById('ao-plan').value = c.alwaysOnPlanId || '';
    document.getElementById('ao-price-rs').value = c.alwaysOnPricePaise ? (c.alwaysOnPricePaise / 100) : '';
    document.getElementById('rzp-status').innerHTML = (c.configured
      ? '<span class="badge ok">Razorpay connected</span>'
      : '<span class="badge warn">Razorpay not configured — tenants cannot top up</span>')
      + (c.hasWebhookSecret ? ' <span class="badge ok">webhook secret set</span>' : ' <span class="badge">no webhook secret</span>')
      + ` &nbsp; Pricing: ${rupees(c.pricePerUnitPaise)}/GB · 1 GB = ${(c.unitBytes/1073741824).toFixed(0)} GiB · `
      + `GST ${c.gstPercent}% · gateway ${c.gatewayPercent}% · min top-up ${rupees(c.minTopupPaise)}`;
  } catch (e) { document.getElementById('rzp-status').textContent = e.message; }
}

async function loadLanding() {
  try {
    const r = await api('/admin/landing');
    document.getElementById('landing-video').value = r.videoUrl || '';
  } catch (e) { /* ignore */ }
}
document.getElementById('landing-save').onclick = async () => {
  try {
    await api('/admin/landing', { method: 'POST', body: { video_url: document.getElementById('landing-video').value } });
    toast('Landing video updated.');
  } catch (e) { toast(e.message, 'err'); }
};

async function loadMeta() {
  try {
    const m = await api('/admin/meta');
    document.getElementById('meta-pixel').value = m.pixelId || '';
    document.getElementById('meta-testcode').value = m.testEventCode || '';
    document.getElementById('meta-status').innerHTML =
      (m.pixelId ? '<span class="badge ok">Pixel set</span>' : '<span class="badge warn">no pixel</span>')
      + (m.hasToken ? ' <span class="badge ok">CAPI token set</span>' : ' <span class="badge">no CAPI token</span>')
      + (m.configured ? ' <span class="badge ok">CAPI will send</span>' : ' <span class="badge warn">CAPI inert</span>');
  } catch (e) { document.getElementById('meta-status').textContent = e.message; }
}
document.getElementById('meta-save').onclick = async () => {
  try {
    await api('/admin/meta', { method: 'POST', body: {
      pixel_id: document.getElementById('meta-pixel').value.trim(),
      capi_token: document.getElementById('meta-token').value.trim(),
      test_event_code: document.getElementById('meta-testcode').value.trim(),
    } });
    document.getElementById('meta-token').value = '';
    toast('Meta settings saved.'); loadMeta();
  } catch (e) { toast(e.message, 'err'); }
};
document.getElementById('meta-test').onclick = async () => {
  const out = document.getElementById('meta-test-out');
  out.style.display = ''; out.textContent = 'Sending test event to Meta…';
  try {
    const r = await api('/admin/meta/test', { method: 'POST', body: { test_event_code: document.getElementById('meta-testcode').value.trim() } });
    out.textContent = (r.ok ? '✓ accepted' : '✗ failed') + ' (HTTP ' + (r.status || '-') + ')\n' + (r.response || r.error || '');
  } catch (e) { out.textContent = e.message; }
};

async function loadGoogle() {
  document.getElementById('google-redirect').textContent = location.origin + '/oauth/google/callback';
  try {
    const g = await api('/admin/google');
    document.getElementById('google-cid').value = g.clientId || '';
    document.getElementById('google-status').innerHTML = (g.clientId && g.hasSecret)
      ? '<span class="badge ok">Google sign-in enabled</span>'
      : '<span class="badge warn">not configured</span>';
  } catch (e) { document.getElementById('google-status').textContent = e.message; }
}
document.getElementById('google-save').onclick = async () => {
  try {
    await api('/admin/google', { method: 'POST', body: {
      client_id: document.getElementById('google-cid').value.trim(),
      client_secret: document.getElementById('google-secret').value.trim(),
    } });
    document.getElementById('google-secret').value = '';
    toast('Google settings saved.'); loadGoogle();
  } catch (e) { toast(e.message, 'err'); }
};

