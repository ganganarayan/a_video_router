<%- include('partials/head') %>
<h1>Super admin — tenants</h1>
<p class="muted">All tenant workspaces. Impersonate one to work inside it exactly as its admin sees it.</p>

<div class="card" id="rzp-card">
  <h2>Platform payments</h2>
  <div class="field" style="max-width:300px">
    <label>Active gateway</label>
    <select id="pay-provider"></select>
  </div>
  <div id="provider-note" class="muted" style="margin:6px 0 14px"></div>

  <h3 style="margin:0 0 6px">Razorpay</h3>
  <p class="muted">Your platform Razorpay account collects tenant top-ups. Keys are stored
  encrypted — no redeploy needed. Set the webhook to
  <span class="mono" id="webhook-url">…/api/billing/webhook</span> (event <span class="mono">payment.captured</span>).</p>
  <div id="rzp-status" class="muted"></div>
  <div class="row" style="align-items:flex-end; flex-wrap:wrap">
    <div class="field"><label>Key ID</label><input id="rzp-keyid" placeholder="rzp_test_..." style="min-width:220px"></div>
    <div class="field"><label>Key secret</label><input id="rzp-secret" type="password" placeholder="leave blank to keep"></div>
    <div class="field"><label>Webhook secret</label><input id="rzp-webhook" type="password" placeholder="leave blank to keep"></div>
    <button class="primary" id="rzp-save">Save keys</button>
  </div>
  <div class="row" style="align-items:flex-end; flex-wrap:wrap; margin-top:14px; border-top:1px solid var(--line); padding-top:14px">
    <div class="field"><label>Always-On plan ID <span class="muted">(Razorpay Subscriptions plan)</span></label>
      <input id="ao-plan" placeholder="plan_…" style="min-width:240px"></div>
    <div class="field"><label>Price ₹/mo (display only)</label><input id="ao-price-rs" type="number" placeholder="999" style="width:130px"></div>
    <button class="primary" id="ao-plan-save">Save plan</button>
  </div>
  <div id="ao-plan-note" class="muted" style="margin-top:6px">Create a monthly ₹999 plan in the Razorpay dashboard (Subscriptions → Plans), then paste its plan_id here to enable Always-On.</div>
</div>

<div class="card" id="landing-card">
  <h2>Landing page video</h2>
  <p class="muted">Embed URL shown below the hero on your public landing page
  (<span class="mono">/</span>). Paste a VidaPulse (or any) embed link — the page reads it live,
  so you can swap it anytime without touching code. Leave blank to hide the video.</p>
  <div class="row" style="align-items:flex-end">
    <div class="field" style="flex:1 1 420px"><label>Video embed URL</label>
      <input id="landing-video" placeholder="https://…/embed/…"></div>
    <button class="primary" id="landing-save">Save</button>
    <a id="landing-preview" href="/" target="_blank">Open landing ↗</a>
  </div>
</div>

<div class="card table-wrap">
  <table id="tenants-table">
    <thead><tr>
      <th>#</th><th>Slug</th><th>Name</th><th>Status</th><th>Users</th>
      <th>Channels</th><th>Uploaded</th><th>Wallet (₹)</th><th>Free upload</th>
      <th>Unmetered</th><th></th>
    </tr></thead>
    <tbody></tbody>
  </table>
</div>

<script>
function rupees(paise) {
  if (paise == null) return '—';
  return '₹' + (Number(paise) / 100).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}

const PROVIDER_LABELS = { razorpay: 'Razorpay', easebuzz: 'Easebuzz', phonepe: 'PhonePe' };

async function loadConfig() {
  document.getElementById('webhook-url').textContent = location.origin + '/api/billing/webhook';
  try {
    const c = await api('/admin/billing/config');

    const sel = document.getElementById('pay-provider');
    sel.innerHTML = (c.providers || ['razorpay']).map((p) => {
      const live = (c.liveProviders || []).includes(p);
      return `<option value="${p}"${p === c.provider ? ' selected' : ''}>`
        + `${PROVIDER_LABELS[p] || p}${live ? '' : ' (activation pending)'}</option>`;
    }).join('');
    const note = document.getElementById('provider-note');
    if (!(c.liveProviders || []).includes(c.provider)) {
      note.innerHTML = `<span class="badge warn">${PROVIDER_LABELS[c.provider] || c.provider} adapter not built yet</span> `
        + 'tenant top-ups will fail until you switch back to Razorpay.';
    } else {
      note.innerHTML = `Tenants pay through <b>${PROVIDER_LABELS[c.provider] || c.provider}</b>. `
        + 'Easebuzz and PhonePe are wired into the schema and will be enabled once those accounts activate.';
    }

    document.getElementById('rzp-keyid').value = c.keyId || '';
    document.getElementById('ao-plan').value = c.alwaysOnPlanId || '';
    document.getElementById('ao-price-rs').value = c.alwaysOnPricePaise ? (c.alwaysOnPricePaise / 100) : '';
    document.getElementById('rzp-status').innerHTML = (c.configured
      ? '<span class="badge ok">Razorpay connected</span>'
      : '<span class="badge warn">Razorpay not configured — tenants cannot top up</span>')
      + (c.hasWebhookSecret ? ' <span class="badge ok">webhook secret set</span>' : ' <span class="badge">no webhook secret</span>')
      + ` &nbsp; Pricing: ${rupees(c.pricePerUnitPaise)}/unit · unit = ${(c.unitBytes/1073741824).toFixed(0)} GiB · `
      + `GST ${c.gstPercent}% · gateway ${c.gatewayPercent}% · min top-up ${rupees(c.minTopupPaise)}`;
  } catch (e) { document.getElementById('rzp-status').textContent = e.message; }
}

async function loadLanding() {
  try {
    const r = await api('/admin/landing');
    document.getElementById('landing-video').value = r.videoUrl || '';
  } catch (e) { /* ignore */ }
}
document.getElementById('landing-save').onclick = async () => {
  try {
    await api('/admin/landing', { method: 'POST', body: { video_url: document.getElementById('landing-video').value } });
    toast('Landing video updated.');
  } catch (e) { toast(e.message, 'err'); }
};

document.getElementById('ao-plan-save').onclick = async () => {
  try {
    const rs = Number(document.getElementById('ao-price-rs').value);
    await api('/admin/billing/always-on', { method: 'POST', body: {
      plan_id: document.getElementById('ao-plan').value.trim(),
      price_paise: rs > 0 ? Math.round(rs * 100) : undefined,
    } });
    toast('Always-On plan saved.');
    loadConfig();
  } catch (e) { toast(e.message, 'err'); }
};

document.getElementById('pay-provider').onchange = async (e) => {
  try {
    await api('/admin/billing/provider', { method: 'POST', body: { provider: e.target.value } });
    toast('Active gateway set to ' + (PROVIDER_LABELS[e.target.value] || e.target.value));
    loadConfig();
  } catch (err) { toast(err.message, 'err'); loadConfig(); }
};

document.getElementById('rzp-save').onclick = async () => {
  try {
    await api('/admin/billing/keys', { method: 'POST', body: {
      key_id: document.getElementById('rzp-keyid').value.trim(),
      key_secret: document.getElementById('rzp-secret').value.trim() || undefined,
      webhook_secret: document.getElementById('rzp-webhook').value.trim() || undefined,
    }});
    document.getElementById('rzp-secret').value = '';
    document.getElementById('rzp-webhook').value = '';
    toast('Razorpay keys saved.');
    loadConfig();
  } catch (e) { toast(e.message, 'err'); }
};

async function load() {
  const rows = await api('/tenants');
  document.querySelector('#tenants-table tbody').innerHTML = rows.map(t => `
    <tr>
      <td>${t.id}</td>
      <td class="mono">${esc(t.slug)}</td>
      <td>${esc(t.name)}</td>
      <td>${t.status === 'active' ? '<span class="badge ok">active</span>' : '<span class="badge err">suspended</span>'}</td>
      <td>${t.users}</td>
      <td>${t.channels}</td>
      <td>${t.uploaded}</td>
      <td class="nowrap">${rupees(t.balance_paise)}
        <button title="Adjust balance" onclick="adjust(${t.id}, '${esc(t.name)}')">±</button></td>
      <td>${t.free_upload_used ? 'used' : 'available'}</td>
      <td><input type="checkbox" ${t.unlimited ? 'checked' : ''} onchange="setUnlimited(${t.id}, this.checked)"></td>
      <td><button class="primary" onclick="impersonate(${t.id})">Impersonate</button></td>
    </tr>
  `).join('') || '<tr><td colspan="11" class="muted">No tenants yet.</td></tr>';
}

async function adjust(id, name) {
  const raw = prompt('Adjust wallet for "' + name + '" by amount in ₹ (use a negative number to debit):', '0');
  if (raw === null) return;
  const rupeesVal = Number(raw);
  if (!Number.isFinite(rupeesVal) || rupeesVal === 0) return;
  try {
    const r = await api('/admin/tenants/' + id + '/adjust', { method: 'POST', body: {
      amount_paise: Math.round(rupeesVal * 100), note: 'super-admin adjustment',
    }});
    toast('New balance: ' + rupees(r.balance));
    load();
  } catch (e) { toast(e.message, 'err'); }
}

async function setUnlimited(id, unlimited) {
  try { await api('/admin/tenants/' + id + '/unlimited', { method: 'POST', body: { unlimited } });
    toast(unlimited ? 'Tenant set to unmetered' : 'Metering enabled for tenant'); }
  catch (e) { toast(e.message, 'err'); load(); }
}

async function impersonate(id) {
  try {
    await api('/impersonate/' + id, { method: 'POST' });
    location.href = '/runs';
  } catch (e) { toast(e.message, 'err'); }
}

loadConfig();
loadLanding();
load().catch(e => toast(e.message, 'err'));
</script>
<%- include('partials/foot') %>
