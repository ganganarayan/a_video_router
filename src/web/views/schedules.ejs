<%- include('partials/head') %>
<h1>Schedules</h1>
<p class="muted">Set when automatic pull runs happen. Each schedule runs the whole pipeline
(Zoom&nbsp;+&nbsp;Fathom) at the time you choose. Paused schedules never run.</p>

<div class="card">
  <h2 id="form-title">Add schedule</h2>
  <div class="row">
    <div class="field"><label>Name</label><input id="s-name" placeholder="Daily pull"></div>
    <div class="field"><label>How often</label>
      <select id="s-freq">
        <option value="daily">Every day</option>
        <option value="weekly">Every week</option>
        <option value="hourly">Every hour</option>
      </select>
    </div>
    <div class="field" id="wrap-dow" style="display:none"><label>Day of week</label>
      <select id="s-dow">
        <option value="1">Monday</option><option value="2">Tuesday</option>
        <option value="3">Wednesday</option><option value="4">Thursday</option>
        <option value="5">Friday</option><option value="6">Saturday</option>
        <option value="0">Sunday</option>
      </select>
    </div>
    <div class="field" id="wrap-time"><label>At time</label><input id="s-time" type="time" value="23:00"></div>
    <div class="field" id="wrap-min" style="display:none"><label>At minutes past the hour</label>
      <input id="s-min" type="number" min="0" max="59" value="0" style="width:90px"></div>
    <div class="field"><label>Timezone</label><input id="s-tz" value="Asia/Kolkata"></div>
    <div class="field"><label>Status</label>
      <select id="s-enabled"><option value="true">Active</option><option value="false">Paused</option></select></div>
    <button class="primary" id="s-save">Save schedule</button>
    <button id="s-cancel" style="display:none">Cancel edit</button>
  </div>
  <p class="muted" id="s-summary" style="margin:.6rem 0 0"></p>
  <p class="muted" style="margin:.3rem 0 0">
    <label style="font-weight:normal"><input type="checkbox" id="s-adv-toggle" style="width:auto;margin-right:6px">
      Advanced — enter a cron expression myself</label></p>
  <div class="field" id="wrap-cron" style="display:none;margin-top:.4rem">
    <label>Cron expression <span class="muted">(min hour day month weekday)</span></label>
    <input id="s-cron" placeholder="0 23 * * *">
  </div>
</div>

<div class="card table-wrap">
  <table id="sched-table">
    <thead><tr><th>Name</th><th>Runs</th><th>Timezone</th><th>State</th><th>Next run</th><th></th></tr></thead>
    <tbody></tbody>
  </table>
</div>

<script>
let editingId = null;
const DOW = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday']; // cron 0=Sun..6=Sat
const pad = (n) => String(n).padStart(2, '0');
const advOn = () => document.getElementById('s-adv-toggle').checked;

// ---- cron <-> friendly controls ----
function buildCron() {
  if (advOn()) return document.getElementById('s-cron').value.trim();
  const freq = document.getElementById('s-freq').value;
  const [h, m] = (document.getElementById('s-time').value || '23:00').split(':').map(Number);
  if (freq === 'daily') return `${m} ${h} * * *`;
  if (freq === 'weekly') return `${m} ${h} * * ${document.getElementById('s-dow').value}`;
  if (freq === 'hourly') return `${Number(document.getElementById('s-min').value || 0)} * * * *`;
  return '';
}

function parseCron(cron) {
  const p = String(cron || '').trim().split(/\s+/);
  if (p.length !== 5) return { advanced: true };
  const [mi, ho, dom, mon, dow] = p;
  const num = (x) => /^\d+$/.test(x);
  if (dom === '*' && mon === '*' && dow === '*' && num(mi) && num(ho)) return { freq: 'daily', time: `${pad(+ho)}:${pad(+mi)}` };
  if (dom === '*' && mon === '*' && num(dow) && num(mi) && num(ho)) return { freq: 'weekly', dow, time: `${pad(+ho)}:${pad(+mi)}` };
  if (dom === '*' && mon === '*' && dow === '*' && ho === '*' && num(mi)) return { freq: 'hourly', min: mi };
  return { advanced: true };
}

// Plain-English description; null means "couldn't simplify, show the raw cron".
function describeCron(cron) {
  const r = parseCron(cron);
  if (r.advanced) return null;
  if (r.freq === 'daily') return `Every day at ${r.time}`;
  if (r.freq === 'weekly') return `Every ${DOW[+r.dow]} at ${r.time}`;
  if (r.freq === 'hourly') return `Every hour, at ${pad(+r.min)} minutes past`;
  return null;
}

// ---- form UI ----
function updateFreqUI() {
  const freq = document.getElementById('s-freq').value;
  document.getElementById('wrap-dow').style.display = freq === 'weekly' ? '' : 'none';
  document.getElementById('wrap-time').style.display = (freq === 'daily' || freq === 'weekly') ? '' : 'none';
  document.getElementById('wrap-min').style.display = freq === 'hourly' ? '' : 'none';
  refreshSummary();
}
function updateAdvUI() {
  const adv = advOn();
  document.getElementById('wrap-cron').style.display = adv ? '' : 'none';
  // Dim the friendly controls when the user is hand-writing a cron expression.
  document.getElementById('s-freq').closest('.field').style.opacity = adv ? '.4' : '';
  if (!adv) updateFreqUI(); else refreshSummary();
}
function refreshSummary() {
  const cron = buildCron();
  const desc = describeCron(cron);
  document.getElementById('s-summary').innerHTML = desc
    ? `Runs: <b>${desc}</b>`
    : (cron ? `Runs on cron <span class="mono">${esc(cron)}</span>` : '');
}

['s-freq', 's-time', 's-dow', 's-min', 's-cron'].forEach((id) =>
  document.getElementById(id).addEventListener('input', refreshSummary));
document.getElementById('s-freq').addEventListener('change', updateFreqUI);
document.getElementById('s-adv-toggle').addEventListener('change', updateAdvUI);

// ---- data ----
async function load() {
  const rows = await api('/schedules');
  document.querySelector('#sched-table tbody').innerHTML = rows.map(s => {
    const desc = describeCron(s.cron_expression);
    const runs = desc ? esc(desc) : `<span class="mono">${esc(s.cron_expression)}</span>`;
    return `
    <tr>
      <td>${esc(s.name)}</td>
      <td>${runs}</td>
      <td>${esc(s.timezone)}</td>
      <td>${s.enabled ? '<span class="badge ok">active</span>' : '<span class="badge warn">paused</span>'}</td>
      <td>${s.nextRun ? fmtDate(s.nextRun) : '—'}</td>
      <td class="row">
        <button onclick='editSched(${JSON.stringify(s).replace(/'/g, "&#39;")})'>Edit</button>
        <button onclick="toggleSched(${s.id}, ${!s.enabled})">${s.enabled ? 'Stop' : 'Resume'}</button>
        <button class="danger" onclick="delSched(${s.id})">Delete</button>
      </td>
    </tr>`;
  }).join('') || '<tr><td colspan="6" class="muted">No schedules — nothing runs automatically. Add one, or run manually from the Runs page.</td></tr>';
}

function formValues() {
  return {
    name: document.getElementById('s-name').value,
    cron_expression: buildCron(),
    timezone: document.getElementById('s-tz').value,
    enabled: document.getElementById('s-enabled').value === 'true',
  };
}

function editSched(s) {
  editingId = s.id;
  document.getElementById('form-title').textContent = 'Edit schedule #' + s.id;
  document.getElementById('s-name').value = s.name;
  document.getElementById('s-tz').value = s.timezone;
  document.getElementById('s-enabled').value = String(s.enabled);
  document.getElementById('s-cancel').style.display = '';

  const r = parseCron(s.cron_expression);
  if (r.advanced) {
    document.getElementById('s-adv-toggle').checked = true;
    document.getElementById('s-cron').value = s.cron_expression;
  } else {
    document.getElementById('s-adv-toggle').checked = false;
    document.getElementById('s-freq').value = r.freq;
    if (r.freq === 'weekly') document.getElementById('s-dow').value = r.dow;
    if (r.freq === 'hourly') document.getElementById('s-min').value = r.min;
    else document.getElementById('s-time').value = r.time;
  }
  updateAdvUI();
  scrollTo({ top: 0, behavior: 'smooth' });
}

function resetForm() {
  editingId = null;
  document.getElementById('form-title').textContent = 'Add schedule';
  document.getElementById('s-cancel').style.display = 'none';
  document.getElementById('s-name').value = '';
  document.getElementById('s-freq').value = 'daily';
  document.getElementById('s-time').value = '23:00';
  document.getElementById('s-dow').value = '1';
  document.getElementById('s-min').value = '0';
  document.getElementById('s-tz').value = 'Asia/Kolkata';
  document.getElementById('s-enabled').value = 'true';
  document.getElementById('s-adv-toggle').checked = false;
  document.getElementById('s-cron').value = '';
  updateAdvUI();
}

document.getElementById('s-save').onclick = async () => {
  const v = formValues();
  if (!v.cron_expression) { toast('Pick how often the schedule should run.', 'err'); return; }
  try {
    await api(editingId ? '/schedules/' + editingId : '/schedules',
      { method: editingId ? 'PUT' : 'POST', body: v });
    toast('Schedule saved'); resetForm(); load();
  } catch (e) { toast(e.message, 'err'); }
};
document.getElementById('s-cancel').onclick = resetForm;

async function toggleSched(id, enabled) {
  try { await api('/schedules/' + id + '/toggle', { method: 'POST', body: { enabled } });
    toast(enabled ? 'Schedule resumed' : 'Schedule stopped'); load(); }
  catch (e) { toast(e.message, 'err'); }
}
async function delSched(id) {
  if (!confirm('Delete this schedule?')) return;
  try { await api('/schedules/' + id, { method: 'DELETE' }); load(); }
  catch (e) { toast(e.message, 'err'); }
}

updateAdvUI();
load().catch(e => toast(e.message, 'err'));
</script>
<%- include('partials/foot') %>
