<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>VideoRouter — Login</title>
  <link rel="stylesheet" href="/public/style.css">
  <script src="/public/eye.js"></script>
  <script src="/public/theme.js"></script>
</head>
<body>
<main>
  <div class="card login-box">
    <h1>VideoRouter</h1>
    <% if (error) { %><p class="badge err"><%= error %></p><% } %>
    <% if (typeof reset !== 'undefined' && reset) { %><p class="badge ok">Password reset — log in with your new password.</p><% } %>
    <form method="post" action="/login">
      <label>Email</label>
      <input type="email" name="email" required autofocus>
      <label>Password</label>
      <input type="password" name="password" required>
      <p><button class="primary" type="submit">Log in</button></p>
    </form>
    <p class="muted" style="margin-top:14px">New here? <a href="/register">Create your workspace — first GB free</a></p>
    <p class="muted"><a href="/forgot">Forgot password?</a></p>
  </div>
</main>
</body>
</html>
