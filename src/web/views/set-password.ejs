<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>VideoRouter — Set password</title>
  <link rel="stylesheet" href="/public/style.css">
  <script src="/public/eye.js"></script>
</head>
<body>
<main>
  <div class="card login-box">
    <h1>Set your password</h1>
    <p class="muted">Signed in as <span class="mono"><%= email %></span>. Set a password to continue.</p>
    <% if (error) { %><p class="badge err"><%= error %></p><% } %>
    <form method="post" action="/set-password">
      <label>New password (min 8 chars)</label>
      <input type="password" name="new_password" required minlength="8" autofocus>
      <p><button class="primary" type="submit">Set password &amp; continue</button></p>
    </form>
    <p class="muted"><a href="/logout">Log out</a></p>
  </div>
</main>
</body>
</html>
