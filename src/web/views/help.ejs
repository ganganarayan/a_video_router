<%- include('partials/head') %>
<h1>Help &amp; Knowledge Base</h1>
<p class="muted">Step-by-step setup guides and answers for every part of AVideoRouter. Search below,
or open a section. Still stuck? See <a href="/contact">Contact us</a>.</p>

<div class="card">
  <div class="field">
    <label>Search help</label>
    <input id="kb-search" type="search" placeholder="Search e.g. Zoom, YouTube, OAuth, schedule, wallet…" autocomplete="off">
  </div>
  <p class="muted" id="kb-count" style="margin:.4rem 0 0"></p>
</div>

<div id="kb-list"></div>
<p class="muted" id="kb-empty" style="display:none">No articles match your search.</p>

<style>
  .kb-cat { margin: 1.2rem 0 .3rem; font-size: 1.05rem; }
  .kb-art { border:1px solid var(--line,#2e3d5c); border-radius:8px; margin:.45rem 0; overflow:hidden; }
  .kb-art > summary { cursor:pointer; padding:.75rem .9rem; font-weight:600; list-style:none; }
  .kb-art > summary::-webkit-details-marker { display:none; }
  .kb-art > summary::before { content:'▸'; color:var(--accent); margin-right:.55rem; display:inline-block; transition:transform .12s; }
  .kb-art[open] > summary::before { transform:rotate(90deg); }
  .kb-art .kb-body { padding:.2rem .9rem 1rem 1.8rem; }
  .kb-art .kb-body p { margin:.5rem 0; }
  .kb-art .kb-body ol.kb-steps { margin:.5rem 0; padding-left:1.3rem; }
  .kb-art .kb-body ol.kb-steps > li { margin:.55rem 0; }
  .kb-part { margin:1rem 0 .3rem; font-weight:700; color:var(--text); border-top:1px solid var(--line,#2e3d5c); padding-top:.8rem; }
  .kb-note { border-left:3px solid var(--accent); background:rgba(79,140,255,.08); padding:.5rem .75rem; border-radius:0 6px 6px 0; margin:.6rem 0; }
  /* Media placeholders — replace with your own screenshots / videos later. */
  .kb-video { display:flex; align-items:center; justify-content:center; gap:.6rem; min-height:150px;
    border:2px dashed var(--accent); border-radius:10px; background:rgba(79,140,255,.06);
    color:var(--muted); margin:.6rem 0; text-align:center; padding:1rem; font-weight:600; }
  .kb-video .kb-play { font-size:1.6rem; }
  .kb-shot { display:block; border:1px dashed var(--line,#2e3d5c); border-radius:8px;
    background:repeating-linear-gradient(45deg, rgba(255,255,255,.02) 0 10px, transparent 10px 20px);
    color:var(--muted); font-size:.85rem; padding:.7rem .8rem; margin:.4rem 0 .2rem; }
  .kb-shot::before { content:'📷 '; }
  mark { background:var(--accent); color:#000; border-radius:2px; padding:0 1px; }
  .kb-flash { animation: kbflash 1.6s ease-out 1; }
  @keyframes kbflash { 0%,15% { box-shadow:0 0 0 2px var(--accent); background:rgba(79,140,255,.10); } 100% { box-shadow:none; background:transparent; } }
</style>

<script>
// Placeholders: elements with data-shot / data-video are where the user will drop their own
// screenshots and walkthrough videos later (edit this file, or a future admin content editor).
const vid  = (id, label) => `<div class="kb-video" data-video="${id}"><span class="kb-play">▶</span>
  <span>Walkthrough video — ${label}<br><small>placeholder · add your video here later</small></span></div>`;
const shot = (id, label) => `<span class="kb-shot" data-shot="${id}">Screenshot: ${label} — add your image here</span>`;
// External deep-link that opens in a new tab.
const ext  = (url, label) => `<a href="${url}" target="_blank" rel="noopener">${label}</a>`;

const KB = [
  // ---------------- GETTING STARTED ----------------
  { id: 'getting-started', cat: 'Getting started', q: 'What does AVideoRouter do, and what do I need?',
    a: `<p>AVideoRouter automatically moves your Zoom / Fathom recordings to YouTube and/or your LMS,
        on a schedule you control — it downloads, uploads, logs the result, and can delete the Zoom
        original afterwards, without you signing into Zoom or YouTube each time.</p>
        <p>You'll need: a <b>Zoom</b> (or Fathom) account, a <b>YouTube channel</b> with its own Google
        account, and — if you publish to a course platform — an <b>LMS with an API</b>. Connect each
        once under <b>Connections</b>, then set up <b>Routing</b> and <b>Schedules</b>.</p>` },
  { cat: 'Getting started', q: 'Setup order (do these in sequence)',
    a: `${vid('getting-started', 'full setup, start to finish')}
        <ol class="kb-steps">
          <li><b>Connections</b> — connect Zoom / Fathom (sources) and YouTube / LMS (destinations).</li>
          <li><b>Routing</b> — decide which source title patterns go to which YouTube channel / LMS course.</li>
          <li><b>Schedules</b> — set when automatic pulls run (or push manually from Sources).</li>
          <li><b>Runs / Logs</b> — watch transfers live and check results.</li>
        </ol>` },

  // ---------------- CONNECT ZOOM ----------------
  { id: 'connect-zoom', cat: 'Connect Zoom', q: 'Step 1 — Turn on cloud recording in Zoom (one time)',
    a: `${vid('zoom-recording', 'enabling Zoom cloud recording')}
        <ol class="kb-steps">
          <li>Sign in to the Zoom web portal at ${ext('https://zoom.us', 'zoom.us')} (browser, not the desktop app).</li>
          <li>Open ${ext('https://zoom.us/account/setting?tab=recording', 'Settings → Recording')} (direct link).</li>
          <li>Turn on <b>Cloud recording</b>.</li>
          <li>Enable <b>Record active speaker with shared screen</b> — this produces the
              “shared screen with speaker view” layout that AVideoRouter picks up automatically.</li>
          <li>Click <b>Save</b>.</li>
        </ol>
        ${shot('zoom-recording', 'Zoom Settings → Recording with Cloud recording enabled')}
        <div class="kb-note">Record your meetings <b>to the cloud</b> (not to your computer) — only
          cloud recordings are visible to AVideoRouter.</div>` },
  { cat: 'Connect Zoom', q: 'Step 2 — Create a Server-to-Server OAuth app in Zoom',
    a: `${vid('zoom-s2s', 'creating the Zoom Server-to-Server OAuth app')}
        <ol class="kb-steps">
          <li>Go to the ${ext('https://marketplace.zoom.us', 'Zoom App Marketplace')} and sign in.</li>
          <li>Top right: ${ext('https://marketplace.zoom.us/develop/create', 'Develop → Build App')}.</li>
          <li>Choose <b>Server-to-Server OAuth</b> → <b>Create</b>. Give it a name like “AVideoRouter”.</li>
          <li>On the <b>App Credentials</b> screen, copy the three values: <b>Account ID</b>,
              <b>Client ID</b>, and <b>Client Secret</b>.</li>
          ${''}
          <li>Fill in <b>Basic Information</b> (company name + a contact name/email) — Zoom requires
              this before the app can activate.</li>
          <li>Open <b>Scopes → Add Scopes</b> and add the Cloud Recording scopes:
              <span class="mono">cloud_recording:read</span> and
              <span class="mono">cloud_recording:write</span> (read lets us fetch recordings; write
              lets you delete them from the dashboard).</li>
          <li>Click <b>Activate your app</b>.</li>
        </ol>
        ${shot('zoom-credentials', 'Zoom App Credentials page showing Account ID / Client ID / Client Secret')}` },
  { cat: 'Connect Zoom', q: 'Step 3 — Paste the Zoom credentials into AVideoRouter',
    a: `<ol class="kb-steps">
          <li>In AVideoRouter, open <b>Connections</b>.</li>
          <li>In the <b>Zoom (Server-to-Server OAuth)</b> card, paste your <b>Account ID</b>,
              <b>Client ID</b> and <b>Client Secret</b>.</li>
          <li>Click <b>Save</b>, then <b>Test connection</b>. Success shows
              “Connected as &lt;your email&gt;”.</li>
        </ol>
        ${shot('zoom-connections', 'AVideoRouter Connections → Zoom card filled in, showing Connected')}
        <div class="kb-note">Credentials are stored <b>encrypted</b> (AES-256-GCM) in the database —
          never in plain text or environment variables.</div>` },

  // ---------------- CONNECT YOUTUBE ----------------
  { cat: 'Connect YouTube', q: 'Step 1 — Create a Google Cloud project & enable the YouTube API',
    a: `${vid('yt-project', 'creating the Google Cloud project')}
        <div class="kb-note">Use <b>one Google Cloud project per YouTube channel</b> — this keeps each
          channel's upload quota separate. Sign in with the Google account that <b>owns the channel</b>.</div>
        <ol class="kb-steps">
          <li>Go to ${ext('https://console.cloud.google.com', 'console.cloud.google.com')} and sign in.</li>
          <li>Top bar → project dropdown → ${ext('https://console.cloud.google.com/projectcreate', 'New Project')}. Name it (e.g. “AVR – Gita main”) → <b>Create</b>.</li>
          <li>Make sure the new project is selected in the top bar.</li>
          <li>Open ${ext('https://console.cloud.google.com/apis/library', 'APIs &amp; Services → Library')}, then open the ${ext('https://console.cloud.google.com/apis/library/youtube.googleapis.com', 'YouTube Data API v3')} page → <b>Enable</b>.</li>
        </ol>
        ${shot('yt-enable-api', 'YouTube Data API v3 page with the Enable button')}` },
  { cat: 'Connect YouTube', q: 'Step 2 — Configure the OAuth consent screen (and PUBLISH it)',
    a: `<ol class="kb-steps">
          <li>Open ${ext('https://console.cloud.google.com/apis/credentials/consent', 'APIs &amp; Services → OAuth consent screen')} (direct link).</li>
          <li>User type: <b>External</b> → <b>Create</b>.</li>
          <li>Fill <b>App name</b>, <b>User support email</b>, and <b>Developer contact email</b> → Save
              and continue through the remaining steps (you can leave scopes/test users default).</li>
          <li><b>Important:</b> back on the ${ext('https://console.cloud.google.com/apis/credentials/consent', 'OAuth consent screen')}, set <b>Publishing status</b> to
              <b>In production</b> (click <b>Publish app</b>).</li>
        </ol>
        ${shot('yt-consent-publish', 'OAuth consent screen showing Publishing status = In production')}
        <div class="kb-note"><b>Why publish matters:</b> if the app is left in “Testing”, Google expires
          the channel's refresh token about every <b>7 days</b> and you'll have to reconnect weekly.
          Publishing to production stops that.</div>` },
  { cat: 'Connect YouTube', q: 'Step 3 — Create the OAuth client & add the redirect URI',
    a: `${vid('yt-oauth', 'creating the OAuth client ID')}
        <ol class="kb-steps">
          <li>Open ${ext('https://console.cloud.google.com/apis/credentials', 'APIs &amp; Services → Credentials')} (direct link).</li>
          <li><b>Create Credentials → OAuth client ID</b>.</li>
          <li>Application type: <b>Web application</b>. Give it a name.</li>
          <li>Under <b>Authorized redirect URIs → Add URI</b>, paste the exact URI shown on the
              AVideoRouter <b>Connections</b> page (under “YouTube channels”). It looks like
              <span class="mono">https://your-domain/oauth/youtube/callback</span> — copy it precisely,
              no trailing slash.</li>
          <li><b>Create</b>, then copy the <b>Client ID</b> and <b>Client Secret</b>.</li>
        </ol>
        ${shot('yt-redirect-uri', 'OAuth client with the Authorized redirect URI added')}` },
  { cat: 'Connect YouTube', q: 'Step 4 — Add the channel in AVideoRouter & authorise',
    a: `<ol class="kb-steps">
          <li>In AVideoRouter open <b>Connections → YouTube channels → Add channel</b>.</li>
          <li>Enter a <b>Label</b>, paste the <b>OAuth Client ID</b> and <b>Client Secret</b>, then
              click <b>Add &amp; connect</b>.</li>
          <li>You're sent to Google — pick the channel's Google account and <b>Allow</b> the requested
              permissions (upload &amp; manage videos).</li>
          <li>You return to AVideoRouter and the channel shows <b>connected</b>. Repeat for more channels.</li>
        </ol>
        ${shot('yt-connected', 'Connections → YouTube channels table showing a connected channel')}
        <div class="kb-note">If a channel ever shows <b>needs reconnect</b>, its authorisation expired
          or was revoked — click <b>Reconnect</b> (and make sure the consent screen is Published, Step 2).</div>` },

  // ---------------- CONNECT FATHOM ----------------
  { cat: 'Connect Fathom', q: 'Connect Fathom as a source',
    a: `${vid('fathom', 'connecting Fathom')}
        <ol class="kb-steps">
          <li>In ${ext('https://fathom.video', 'Fathom')}, open your account settings and find your <b>API key</b> (Settings → integrations / API).</li>
          <li>In AVideoRouter open <b>Connections</b> → the <b>Fathom</b> card.</li>
          <li>Paste the <b>API key</b> → <b>Save</b> → <b>Test connection</b>.</li>
        </ol>
        ${shot('fathom-key', 'AVideoRouter Fathom card with API key saved')}
        <div class="kb-note">Fathom is <b>read-only</b> — AVideoRouter never deletes anything on Fathom.</div>` },

  // ---------------- CONNECT LMS ----------------
  { cat: 'Connect your LMS', q: 'Connect your LMS (video-ingest API)',
    a: `${vid('lms', 'connecting your LMS')}
        <ol class="kb-steps">
          <li>In your LMS admin, get the <b>video-ingest API base URL</b> and an <b>API key</b>.</li>
          <li>In AVideoRouter open <b>Connections</b> → the <b>LMS</b> card.</li>
          <li>Enter the <b>Base URL</b> and <b>API key</b> → <b>Save</b> → <b>Test connection</b>.</li>
          <li>Set the <b>course/module IDs</b> per tag on the <b>Routing</b> page so each video lands in
              the right course.</li>
        </ol>
        ${shot('lms-card', 'AVideoRouter LMS card with Base URL + API key')}
        <div class="kb-note">The LMS is optional. Until it's connected, uploaded videos stay
          <span class="mono">lms_status=pending</span> and are pushed automatically the moment you connect —
          no re-work.</div>` },

  // ---------------- ROUTING ----------------
  { id: 'routing', cat: 'Routing', q: 'How does routing work?',
    a: `<p>On <b>Routing</b> you create rules that match a recording's title (contains / prefix / regex)
        and send it to a chosen <b>YouTube channel</b> (and optionally an <b>LMS course/module</b>), with
        options like playlist, privacy, and a custom title. When a recording is pulled, AVideoRouter
        applies the first matching rule.</p>` },
  { cat: 'Routing', q: 'A recording was “skipped — no routing rule matched”',
    a: `<p>Add a rule on <b>Routing</b> whose pattern matches that title. Old skipped recordings are
        retried automatically on the next run once a matching rule exists.</p>` },

  // ---------------- SOURCES & MANUAL PUSH ----------------
  { id: 'push-single', cat: 'Sources & manual push', q: 'Push a single recording right now',
    a: `<ol class="kb-steps">
          <li>Open <b>Sources</b> and find the recording.</li>
          <li>(Optional) set a YouTube <b>title</b>/<b>description</b> before pushing.</li>
          <li>Click <b>Push</b> — it uploads immediately using that recording's destinations.</li>
        </ol>` },
  { cat: 'Sources & manual push', q: 'Delete a recording from Zoom',
    a: `<p>Deletion is <b>manual only</b> — the pipeline never auto-deletes. On <b>Sources</b>, the
        <b>Delete from Zoom</b> button unlocks only after the recording has a YouTube video ID (i.e. it's
        safely uploaded). You do it from the dashboard, without signing into Zoom.</p>` },

  // ---------------- SCHEDULES ----------------
  { id: 'schedules', cat: 'Schedules', q: 'Set up automatic pulls',
    a: `<ol class="kb-steps">
          <li>Open <b>Schedules</b> → add a schedule and choose its time.</li>
          <li>When it fires, AVideoRouter pulls new recordings and routes them automatically.</li>
          <li>You can <b>stop / resume / edit / delete</b> a schedule anytime without losing its setup.</li>
        </ol>
        <div class="kb-note">If no schedule is active, nothing runs automatically — use manual push instead.</div>` },

  // ---------------- RUNS & LOGS ----------------
  { id: 'runs', cat: 'Runs & logs', q: 'Where do I see progress and results?',
    a: `<p><b>Runs</b> shows live speed / ETA / progress while a push is in flight (roughly 1&nbsp;GB per
        90&nbsp;seconds). <b>Logs</b> shows the outcome and any error per recording.</p>` },
  { cat: 'Runs & logs', q: 'A row says “Skipped — wallet empty”',
    a: `<p>The upload was held because your wallet had no video credits. Top up on <b>Billing</b> — held
        rows resume automatically on the next run. Nothing is lost.</p>
        <div class="kb-note">A transfer that has <b>already started is never interrupted</b> for a low
        balance — it finishes uploading even if that takes your wallet <b>below zero</b>. Any negative
        balance is simply adjusted against your next top-up. Only the <b>next</b> not-yet-started upload
        waits until credits are added.</div>` },

  // ---------------- BILLING ----------------
  { id: 'billing', cat: 'Billing & wallet', q: 'How billing works & buying credits',
    a: `<p>Pay-as-you-go: from <b>₹50 per unit of transfer</b> — one unit is 1&nbsp;GB, rounded up (a 2.5&nbsp;GB
        file is 3 units). Your first upload is free. Buy credits in <b>multiples of 10</b> on the <b>Billing</b>
        page; bigger packs cost less per unit (₹45 at 50, ₹40 at 100) with the discount added as bonus credit.
        Prices shown include GST + gateway fees, and the wallet is credited the face value. Balance shows in ₹ and an
        approximate number of units. The daily scheduler and staff seats need an <b>Always-On</b> subscription
        (₹999/month); transfers stay pay-as-you-go on top.</p>
        <div class="kb-note">Have a GSTIN? Add it in <b>Settings</b> (or the top-up popup) if you want a
        GST invoice to claim input credit. There are <b>no refunds</b> — see
        <a href="/refund">Refund policy</a> — but your balance stays in your wallet until you use it.</div>` },

  // ---------------- TEAM ----------------
  { id: 'team', cat: 'Team & permissions', q: 'Add staff and set permissions',
    a: `<ol class="kb-steps">
          <li>Open <b>Team</b> → add a staff member (name, email, permission).</li>
          <li>They sign in with their email — no password the first time — and set one on first login.</li>
        </ol>
        <p><b>View</b> = read-only. <b>Edit</b> = can push &amp; edit, but cannot manage staff,
        connections or billing, and cannot delete. Only the <b>owner</b> can do those.</p>` },

  // ---------------- TROUBLESHOOTING ----------------
  { cat: 'Troubleshooting', q: 'A recording didn’t upload',
    a: `<p>Open <b>Logs</b> and read the error on that row. Common causes: the destination isn't connected
        (fix on <b>Connections</b>), the wallet is empty (top up on <b>Billing</b>), the YouTube channel
        needs reconnecting, or the LMS isn't live yet (the row stays pending and back-fills automatically).</p>` },
  { cat: 'Troubleshooting', q: 'YouTube keeps asking me to reconnect every week',
    a: `<p>Your Google OAuth consent screen is still in “Testing”, so Google expires the token every ~7 days.
        Fix it once: open the ${ext('https://console.cloud.google.com/apis/credentials/consent', 'OAuth consent screen')}
        and click <b>Publish app</b> (see Connect YouTube, Step 2), then <b>Reconnect</b> the channel.</p>` },
];

const listEl = document.getElementById('kb-list');
const emptyEl = document.getElementById('kb-empty');
const countEl = document.getElementById('kb-count');
const searchEl = document.getElementById('kb-search');

function slugify(s) {
  return String(s).toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '').slice(0, 60);
}
function artId(a) { return a.id || slugify(a.q); }

function render(filter) {
  const f = (filter || '').trim().toLowerCase();
  const matched = KB.filter(a => !f || (a.q + ' ' + a.a + ' ' + a.cat).toLowerCase().includes(f));
  const cats = [...new Set(matched.map(a => a.cat))];
  listEl.innerHTML = cats.map(cat => {
    const arts = matched.filter(a => a.cat === cat).map(a => `
      <details class="kb-art" id="${artId(a)}"${f ? ' open' : ''}>
        <summary>${hl(a.q, f)}</summary>
        <div class="kb-body">${a.a}</div>
      </details>`).join('');
    return `<h2 class="kb-cat">${esc(cat)}</h2>${arts}`;
  }).join('');
  emptyEl.style.display = matched.length ? 'none' : 'block';
  countEl.textContent = f
    ? `${matched.length} article${matched.length === 1 ? '' : 's'} matching “${f}”`
    : `${KB.length} articles across ${new Set(KB.map(a => a.cat)).size} sections`;
}

// Deep-link support: /help#<article-id> opens and scrolls to that article, and
// briefly highlights it. Used by the per-page "?" help buttons.
function openHash() {
  const id = decodeURIComponent((location.hash || '').replace(/^#/, ''));
  if (!id) return;
  const el = document.getElementById(id);
  if (!el) return;
  el.open = true;
  el.scrollIntoView({ behavior: 'smooth', block: 'start' });
  el.classList.remove('kb-flash');
  void el.offsetWidth; // restart the animation if re-triggered
  el.classList.add('kb-flash');
}
window.addEventListener('hashchange', () => { render(''); searchEl.value = ''; openHash(); });

function hl(text, f) {
  const safe = esc(text);
  if (!f) return safe;
  try {
    return safe.replace(new RegExp('(' + f.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + ')', 'ig'), '<mark>$1</mark>');
  } catch { return safe; }
}

searchEl.addEventListener('input', () => render(searchEl.value));
render('');
openHash();
</script>
<%- include('partials/foot') %>
